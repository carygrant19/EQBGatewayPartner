        <div class="startbar-collapse" id="startbarCollapse" data-simplebar>
            <div class="brand text-light font-weight-bold fixed-top bg-danger" style="margin-left: -1rem; width:auto; margin-right: -1rem">
                <a href="/Home" class="nav-link logo">
                    <span>
                        <img src="~/images/EQB_Logo_Inverted.png" alt="Equicom Savings" class="thumb-md logo-light">
