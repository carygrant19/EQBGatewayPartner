                    </div>
                    <div class="info p-2">
                        <a href="" class="nav-link d-block text-xs">
                            <b style="font-size:.8rem">@HttpContextAccessor.HttpContext.Session.GetString("FullName")</b>
                        </a>
                    </div>
                </div> *@
                @if (@ViewData["Navigation"] != null)
                { 
