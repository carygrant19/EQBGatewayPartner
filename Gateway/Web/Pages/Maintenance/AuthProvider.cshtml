@page
@model Gateway.Web.Pages.Maintenance.AuthProviderModel
@{
    ViewData["Title"] = Model.PageTitle;
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div id="AuthProviderController">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>
                        <button type="button" class="btn btn-md" onclick="GoBack();">
                            <i class="nav-icon fa fa-lg fa-arrow-circle-left text-secondary"></i>
                        </button>
                        <b class="text-lg">@ViewData["Title"]</b>
                    </h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        @foreach (var item in Model.PageUrl.Split('/'))
                        {
                            if (!string.IsNullOrEmpty(item))
                            {
                                <li class="breadcrumb-item">@item</li>
                            }
                        }
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid" autocomplete="off">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-sm-12 col-md-6 col-lg-6 mb-3">
                                    <div class="input-group">
                                        @if (Model.Permission.Contains("[SEARCH]"))
                                        {
                                            <input type="text" id="searchDescription" autocomplete="off" class="form-control" placeholder="Search Provider Name" v-model="search.description" v-on:keypress.enter="Search();" />
                                            <button type="button" class="btn btn-outline-secondary btn-sm" v-on:click="Search();">
                                                <i class="nav-icon fas fa-search"></i> Search
                                            </button>
                                        }

                                        @if (Model.Permission.Contains("[ADD]"))
                                        {
                                            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#formModal" v-on:click="Add()">
                                                <i class="nav-icon fas fa-plus-circle"></i> Add Auth Provider
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12 table-responsive" v-show="!show_table">
                                    <span>No provider record(s) found!</span>
                                </div>

                                <div class="col-12 table-responsive" v-show="show_table">
                                    <div class="row form-group pb-3">
                                        <div class="col-auto">Show</div>
                                        <div class="col-auto">
                                            <select name="params_length" v-model="params.pageSize" class="form-control form-control-sm custom-select" v-on:change="ItemCountChange()" style="min-width: 60px;">
                                                <option v-for="pageSize in pageSizeArray" :key="pageSize" :value="pageSize">{{ pageSize }}</option>
                                            </select>
                                        </div>
                                        <div class="col-auto">records</div>
                                    </div>

                                    <table class="table datatable fs-13">
                                        <thead class="table-light">
                                            <tr>
                                                <th width="15%">Code <i :class="['fas', SortClass('Code')]" style="cursor:pointer" v-on:click="Sort('Code')"></i></th>
                                                <th width="20%">Name <i :class="['fas', SortClass('Name')]" style="cursor:pointer" v-on:click="Sort('Name')"></i></th>
                                                <th width="20%">Issuer</th>
                                                <th width="15%">Audience</th>
                                                <th width="10%" class="text-center">Lifetime (Mins)</th>
                                                <th width="10%" class="text-center">Status</th>
                                                <th class="text-center" width="10%">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr v-for="record in records" :key="record.id">
                                                <td class="align-middle fw-bold">{{ record.code }}</td>
                                                <td class="align-middle">{{ record.name }}</td>
                                                <td class="align-middle"><code>{{ record.issuer }}</code></td>
                                                <td class="align-middle"><code>{{ record.audience }}</code></td>
                                                <td class="text-center align-middle">{{ record.tokenLifetimeMinutes }}</td>
                                                <td class="text-center align-middle">
                                                    <span class="badge bg-success" v-if="record.isActive">Active</span>
                                                    <span class="badge bg-secondary" v-else>Inactive</span>
                                                </td>
                                                <td class="text-center align-middle">
                                                    @if (Model.Permission.Contains("[EDIT]"))
                                                    {
                                                        <button type="button" class="btn btn-info btn-sm mx-1" data-bs-toggle="modal" data-bs-target="#formModal" v-on:click="Edit(record)" data-tooltip="tooltip" title="Edit">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                    }

                                                    @if (Model.Permission.Contains("[DELETE]"))
                                                    {
                                                        <button type="button" class="btn btn-danger btn-sm mx-1" v-on:click="Delete(record);" v-if="!record.deleted" data-tooltip="tooltip" title="Delete">
                                                            <i class="far fa-trash-alt"></i>
                                                        </button>
                                                    }

                                                    @if (Model.Permission.Contains("[RESTORE]"))
                                                    {
                                                        <button type="button" class="btn btn-success btn-sm mx-1" v-on:click="Restore(record);" v-if="record.deleted" data-tooltip="tooltip" title="Restore">
                                                            <i class="fas fa-undo"></i>
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="col-12 table-responsive" v-show="show_table">
                                    <ul id="sync-pagination" class="pagination-sm float-end"></ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.Permission.Contains("[ADD]") || Model.Permission.Contains("[EDIT]"))
            {
                <div id="formModal" class="modal fade text-sm" tabindex="-1" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false">
                    <div class="modal-dialog modal-md" role="document">
                        <form name="formModal" id="form" method="post" autocomplete="off" data-parsley-validate="">
                            <div class="modal-content">
                                <div class="modal-header bg-danger text-white">
                                    <h5 class="modal-title left"><i :class="['fa', ActionModeIcon()]"></i> {{ actionMode }} @ViewData["Title"]</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col-sm-12 mb-2">
                                            <div class="form-group">
                                                <label for="Code">Provider Code <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control text-uppercase" name="Code"
                                                       v-model="formData.code"
                                                       :disabled="disableControl.code"
                                                       data-parsley-required="true"
                                                       data-parsley-trigger="change focusout"
                                                       placeholder="e.g. JWT_EQB_INTERNAL" />
                                            </div>
                                        </div>

                                        <div class="col-sm-12 mb-2">
                                            <div class="form-group">
                                                <label for="Name">Provider Name <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control" name="Name"
                                                       v-model="formData.name"
                                                       data-parsley-required="true"
                                                       data-parsley-trigger="change focusout"
                                                       placeholder="e.g. Equicom Gateway Token Issuer" />
                                            </div>
                                        </div>

                                        <div class="col-sm-12 mb-2">
                                            <div class="form-group">
                                                <label for="Issuer">JWT Issuer <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control" name="Issuer"
                                                       v-model="formData.issuer"
                                                       data-parsley-required="true"
                                                       data-parsley-trigger="change focusout"
                                                       placeholder="e.g. https://gateway.equicom.com" />
                                            </div>
                                        </div>

                                        <div class="col-sm-12 mb-2">
                                            <div class="form-group">
                                                <label for="Audience">JWT Audience <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control" name="Audience"
                                                       v-model="formData.audience"
                                                       data-parsley-required="true"
                                                       data-parsley-trigger="change focusout"
                                                       placeholder="e.g. EQB_Microservices" />
                                            </div>
                                        </div>

                                        <div class="col-sm-12 mb-2">
                                            <div class="form-group">
                                                <label for="SecretKey">Secret Key <span class="text-danger">*</span></label>
                                                <input type="password" class="form-control" name="SecretKey"
                                                       v-model="formData.secretKey"
                                                       data-parsley-required="true"
                                                       data-parsley-trigger="change focusout"
                                                       placeholder="HMAC SHA256 Secret (At least 32 characters)" />
                                            </div>
                                        </div>

                                        <div class="col-sm-12 mb-2">
                                            <div class="form-group">
                                                <label for="TokenLifetimeMinutes">Token Lifetime (Minutes) <span class="text-danger">*</span></label>
                                                <input type="number" class="form-control" name="TokenLifetimeMinutes"
                                                       v-model="formData.tokenLifetimeMinutes"
                                                       min="1" max="1440"
                                                       data-parsley-required="true"
                                                       data-parsley-trigger="change focusout" />
                                            </div>
                                        </div>

                                        <div class="col-sm-12 mb-2">
                                            <div class="form-check form-switch mt-2">
                                                <input class="form-check-input" type="checkbox" id="isActive" v-model="formData.isActive">
                                                <label class="form-check-label fw-bold" for="isActive">Is Active</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer justify-content-between">
                                    <button type="button" class="btn btn-default btn-sm" data-bs-dismiss="modal"><i class="nav-icon fas fa-times-circle"></i> Close</button>
                                    <button type="button" class="btn btn-success btn-sm" v-on:click="Save()"><i class="nav-icon fas fa-check-circle"></i> Submit</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

<style>
    .modal {
        overflow: auto !important;
    }
</style>

@section scripts
{
    <script src="~/js/app/directive/common.js" asp-append-version="true"></script>
    <script src="~/js/app/services/authProvider.js" asp-append-version="true"></script>
    <script src="~/js/app/controller/maintenance/authProvider.js" asp-append-version="true"></script>
}


