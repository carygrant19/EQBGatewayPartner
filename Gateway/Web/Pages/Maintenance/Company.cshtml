@page
@model Gateway.Pages.Maintenance.CompanyModel
@{
    ViewData["Title"] = Model.PageTitle;
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div id="CompanyController">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>
                        <button type="button" class="btn btn-md" onclick="GoBack();">
                            <i class="nav-icon fa fa-lg fa-arrow-circle-left text-secondary"></i>
                        </button>
                        <b class="text-lg">@ViewData["Title"]</b>
                    </h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        @foreach (var item in Model.PageUrl.Split('/'))
                        {
                            if (!string.IsNullOrEmpty(item))
                            {
                                <li class="breadcrumb-item">@item</li>
                            }
                        }
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid" autocomplete="off">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-sm-12 col-md-6 col-lg-6 mb-3">
                                    <div class="input-group">
                                        @if (Model.Permission.Contains("[SEARCH]"))
                                        {
                                            <input type="text" id="searchDescription" autocomplete="off" class="form-control" placeholder="Search Description" v-model="search.description" v-on:keypress.enter="Search();" />
                                            <button type="button" class="btn btn-outline-secondary btn-sm" v-on:click="Search();">
                                                <i class="nav-icon fas fa-search"></i> Search
                                            </button>
                                        }

                                        @if (Model.Permission.Contains("[ADD]"))
                                        {
                                            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#formModal" v-on:click="Add()">
                                                <i class="nav-icon fas fa-plus-circle"></i> Add Company
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12 table-responsive" v-show="!show_table">
                                    <span>No company record(s) found!</span>
                                </div>

                                <div class="col-12 table-responsive" v-show="show_table">
                                    <div class="row form-group pb-3">
                                        <div class="col-auto">Show</div>
                                        <div class="col-auto">
                                            <select name="params_length" v-model="params.pageSize" class="form-control form-control-sm custom-select" v-on:change="ItemCountChange()" style="min-width: 60px;">
                                                <option v-for="pageSize in pageSizeArray" :key="pageSize" :value="pageSize">{{ pageSize }}</option>
                                            </select>
                                        </div>
                                        <div class="col-auto">records</div>
                                    </div>

                                    <table class="table datatable fs-13">
                                        <thead class="table-light">
                                            <tr>
                                                <th width="35%">Code <i :class="['fas', SortClass('Code')]" style="cursor:pointer" v-on:click="Sort('Code')"></i></th>
                                                <th width="50%">Description <i :class="['fas', SortClass('Description')]" style="cursor:pointer" v-on:click="Sort('Description')"></i></th>
                                                <th class="text-center" width="15%">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr v-for="record in records" :key="record.id">
                                                <td class="align-middle fw-bold">{{ record.code }}</td>
                                                <td class="align-middle">{{ record.description }}</td>
                                                <td class="text-center align-middle">
                                                    <div class="btn-group btn-group-sm">
                                                    @if (Model.Permission.Contains("[EDIT]"))
                                                    {
                                                        <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#formModal" v-on:click="Edit(record)" data-tooltip="tooltip" title="Edit">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                    }

                                                    @if (Model.Permission.Contains("[DELETE]"))
                                                    {
                                                        <button type="button" class="btn btn-outline-danger" v-on:click="Delete(record);" v-if="!record.deleted" data-tooltip="tooltip" title="Delete">
                                                            <i class="far fa-trash-alt"></i>
                                                        </button>
                                                    }

                                                    @if (Model.Permission.Contains("[RESTORE]"))
                                                    {
                                                        <button type="button" class="btn btn-outline-success" v-on:click="Restore(record);" v-if="record.deleted" data-tooltip="tooltip" title="Restore">
                                                            <i class="fas fa-undo"></i>
                                                        </button>
                                                    }
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="col-12 table-responsive" v-show="show_table">
                                    <ul id="sync-pagination" class="pagination-sm float-end"></ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.Permission.Contains("[ADD]") || Model.Permission.Contains("[EDIT]"))
            {
                <div id="formModal" class="modal fade text-sm" tabindex="-1" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false">
                    <div class="modal-dialog modal-md" role="document">
                        <form name="formModal" id="form" method="post" autocomplete="off" data-parsley-validate="">
                            <div class="modal-content">
                                <div class="modal-header bg-danger text-white">
                                    <h5 class="modal-title left"><i :class="['fa', ActionModeIcon()]"></i> {{ actionMode }} @ViewData["Title"]</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col-sm-12 mb-2">
                                            <div class="form-group">
                                                <label for="Code">Company Code <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control text-uppercase" name="Code"
                                                       v-model="formData.code"
                                                       :disabled="disableControl.code"
                                                       data-parsley-required="true"
                                                       data-parsley-trigger="change focusout"
                                                       placeholder="e.g. EQB" />
                                            </div>
                                        </div>
                                        <div class="col-sm-12 mb-2">
                                            <div class="form-group">
                                                <label for="Description">Company Description <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control" name="Description"
                                                       v-model="formData.description"
                                                       data-parsley-required="true"
                                                       data-parsley-trigger="change focusout"
                                                       placeholder="e.g. Equicom Savings Bank" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer justify-content-between">
                                    <button type="button" class="btn btn-default btn-sm" data-bs-dismiss="modal"><i class="nav-icon fas fa-times-circle"></i> Close</button>
                                    <button type="button" class="btn btn-success btn-sm" v-on:click="Save()"><i class="nav-icon fas fa-check-circle"></i> Submit</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

<style>
    .modal {
        overflow: auto !important;
    }
</style>

@section scripts
{
    <script src="~/js/app/directive/common.js" asp-append-version="true"></script>
    <script src="~/js/app/services/company.js" asp-append-version="true"></script>
    <script src="~/js/app/controller/maintenance/company.js" asp-append-version="true"></script>
}