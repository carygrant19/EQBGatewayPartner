@page
@using Gateway.Web
@model Gateway.Web.Pages.HomeModel
@{
    ViewData["Title"] = "Home";
}
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<section class="content-header py-2 mb-2">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <span class="fs-4 fw-bold text-body"><i class="fas fa-home me-2 text-primary"></i>@ViewData["Title"]</span>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <ol class="breadcrumb float-sm-end mb-0 text-xs">
                    @foreach (var item in Model.PageUrl.Split('/'))
                    {
                        if (!String.IsNullOrEmpty(@item))
                        {
                            <li class="breadcrumb-item text-capitalize">@item</li>
                        }
                    }
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid" id="controller" autocomplete="off" data-aspire-base="@Model.AspireDashboardUrl">
        <div class="row g-3">
            <!-- Left Panel: User Profile & Recent Activities -->
            <div class="col-12 col-xl-3 col-lg-4">
                <div class="card border shadow-sm rounded-3 mb-3 bg-body">
                    <div class="card-body box-profile p-3 text-center">
                        <div class="mb-3">
                            <img src="@HttpContextAccessor.HttpContext!.Session.GetString("AppUrl")/Home?handler=UserProfileImage&timestamp=@DateTime.UtcNow.Ticks"
                                 alt="Profile Picture" class="rounded-circle shadow-sm border" style="width: 110px; height: 110px; object-fit: cover;">
                        </div>
                        <h5 class="fw-bold text-body mb-1">@HttpContextAccessor.HttpContext!.Session.GetString("FullName")</h5>
                        <p class="text-body-secondary small mb-3">@HttpContextAccessor.HttpContext!.Session.GetString("Email")</p>

                        <ul class="list-group list-group-flush text-start small border-top">
                            <li class="list-group-item bg-transparent px-0 py-2 d-flex justify-content-between">
                                <span class="text-body-secondary"><i class="fas fa-user text-danger me-2"></i>Username</span>
                                <b class="text-body">@HttpContextAccessor.HttpContext!.Session.GetString("Username")</b>
                            </li>
                            <li class="list-group-item bg-transparent px-0 py-2 d-flex justify-content-between">
                                <span class="text-body-secondary"><i class="fas fa-building text-danger me-2"></i>Branch</span>
                                <b class="text-body">@HttpContextAccessor.HttpContext!.Session.GetString("BranchCode")</b>
                            </li>
                            <li class="list-group-item bg-transparent px-0 py-2 d-flex justify-content-between">
                                <span class="text-body-secondary"><i class="fas fa-desktop text-danger me-2"></i>Terminal</span>
                                <b class="text-body">@HttpContextAccessor.HttpContext!.Session.GetString("Terminal")</b>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="card border shadow-sm rounded-3 bg-body">
                    <div class="card-header bg-transparent border-bottom py-2">
                        <h6 class="card-title fw-bold text-body fs-6 mb-0">
                            <i class="fas fa-history text-secondary me-2"></i>Personal Activity Log
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center gap-2 mb-3 text-xs text-body-secondary">
                            <span>Show</span>
                            <select v-model="params.pageSize" class="form-select form-select-sm w-auto" v-on:change="ItemCountChange()">
                                <option v-for="pageSize in pageSizeArray" :key="pageSize" :value="pageSize">{{ pageSize }}</option>
                            </select>
                            <span>records</span>
                        </div>

                        <div v-for="record in records" :key="record.id" class="border-bottom pb-2 mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.65rem;">{{ record.moduleName }}</span>
                                <small class="text-body-secondary" style="font-size: 0.65rem;">
                                    <i class="fas fa-clock me-1"></i>{{ $formatDateText(record.logDate) }} {{ $formatTime(record.logDate) }}
                                </small>
                            </div>
                            <span class="badge bg-info-subtle text-info border border-info-subtle mb-1" style="font-size: 0.65rem;">{{ record.action }}</span>
                            <p class="text-body small mb-0 text-truncate" :title="record.details">{{ record.details }}</p>
                        </div>

                        <div v-if="records.length === 0" class="text-center text-muted py-3 small">
                            No user activities found.
                        </div>

                        <div class="mt-2" v-show="show_table">
                            <ul id="sync-pagination" class="pagination-sm float-end mb-0"></ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Panel: Gateway Real-Time Operations & Aspire Telemetry -->
            <div class="col-12 col-xl-9 col-lg-8">
                <!-- Gateway Nodes Health Bar -->
                <div class="row g-2 mb-3">
                    <div class="col-12 col-md-4">
                        <div class="p-2 border rounded bg-body-secondary d-flex align-items-center justify-content-between">
                            <div>
                                <small class="text-body-secondary d-block text-uppercase fw-semibold" style="font-size:0.68rem;">Active Gateway Routes</small>
                                <span class="fs-5 fw-bold text-body">{{ metrics.activeRoutesCount }}</span>
                            </div>
                            <i class="fas fa-route fa-lg text-primary opacity-75"></i>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-2 border rounded bg-body-secondary d-flex align-items-center justify-content-between">
                            <div>
                                <small class="text-body-secondary d-block text-uppercase fw-semibold" style="font-size:0.68rem;">Authorized Clients</small>
                                <span class="fs-5 fw-bold text-body">{{ metrics.activeClientsCount }}</span>
                            </div>
                            <i class="fas fa-users fa-lg text-info opacity-75"></i>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-2 border rounded bg-body-secondary d-flex align-items-center justify-content-between">
                            <div>
                                <small class="text-body-secondary d-block text-uppercase fw-semibold" style="font-size:0.68rem;">Unhealthy Target Hosts</small>
                                <span class="fs-5 fw-bold" :class="metrics.unhealthyHostsCount > 0 ? 'text-danger' : 'text-success'">
                                    {{ metrics.unhealthyHostsCount }}
                                </span>
                            </div>
                            <i class="fas fa-heartbeat fa-lg text-danger opacity-75"></i>
                        </div>
                    </div>
                </div>

                <!-- KPI Cards -->
                <div class="row g-3 mb-3">
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border shadow-sm rounded-3 p-3 bg-body h-100">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <small class="text-body-secondary text-uppercase fw-semibold" style="font-size: 0.7rem;">Volume Today</small>
                                    <h4 class="fw-bold mb-0 mt-1 text-body">{{ metrics.totalRequestsToday }}</h4>
                                    <small class="text-body-secondary">{{ metrics.status2xxCount }} successful (2xx)</small>
                                </div>
                                <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                                    <i class="fas fa-exchange-alt"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border shadow-sm rounded-3 p-3 bg-body h-100">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <small class="text-body-secondary text-uppercase fw-semibold" style="font-size: 0.7rem;">Success Rate</small>
                                    <h4 class="fw-bold mb-0 mt-1 text-success">{{ metrics.successRatePercentage }}%</h4>
                                    <small class="text-danger">{{ metrics.status4xxCount + metrics.status5xxCount }} errors</small>
                                </div>
                                <div class="p-3 bg-success-subtle text-success rounded-circle">
                                    <i class="fas fa-shield-alt"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border shadow-sm rounded-3 p-3 bg-body h-100">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <small class="text-body-secondary text-uppercase fw-semibold" style="font-size: 0.7rem;">Avg Latency</small>
                                    <h4 class="fw-bold mb-0 mt-1 text-body">{{ metrics.averageLatencyMs }} ms</h4>
                                    <small class="text-body-secondary">Roundtrip duration</small>
                                </div>
                                <div class="p-3 bg-info-subtle text-info rounded-circle">
                                    <i class="fas fa-stopwatch"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border shadow-sm rounded-3 p-3 bg-body h-100">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <small class="text-body-secondary text-uppercase fw-semibold" style="font-size: 0.7rem;">Exceptions Logged</small>
                                    <h4 class="fw-bold mb-0 mt-1 text-danger">{{ recentExceptionsCount }}</h4>
                                    <small class="text-danger">Critical exceptions</small>
                                </div>
                                <div class="p-3 bg-danger-subtle text-danger rounded-circle">
                                    <i class="fas fa-exclamation-triangle"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Top Routes & Hourly Traffic -->
                <div class="row g-3 mb-3">
                    <div class="col-12 col-xl-6">
                        <div class="card border shadow-sm rounded-3 bg-body h-100">
                            <div class="card-header bg-transparent border-bottom py-2">
                                <h6 class="fw-bold mb-0 text-body fs-6">
                                    <i class="fas fa-fire text-danger me-2"></i>Top 5 Endpoints Today
                                </h6>
                            </div>
                            <div class="card-body p-2">
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead>
                                            <tr class="text-muted text-xs text-uppercase bg-body-tertiary">
                                                <th>Route Code</th>
                                                <th>Name</th>
                                                <th class="text-end">Calls</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr v-for="route in metrics.topRoutes" :key="route.routeCode">
                                                <td><code class="fw-semibold text-warning bg-transparent p-0">{{ route.routeCode }}</code></td>
                                                <td><span class="text-body small">{{ route.routeName }}</span></td>
                                                <td class="text-end"><span class="badge bg-body-secondary text-body border">{{ route.requestCount }}</span></td>
                                            </tr>
                                            <tr v-if="!metrics.topRoutes || metrics.topRoutes.length === 0">
                                                <td colspan="3" class="text-center text-muted py-3 small">No route traffic logged yet.</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-6">
                        <div class="card border shadow-sm rounded-3 bg-body h-100">
                            <div class="card-header bg-transparent border-bottom py-2">
                                <h6 class="fw-bold mb-0 text-body fs-6">
                                    <i class="fas fa-clock text-info me-2"></i>Hourly Traffic Trend
                                </h6>
                            </div>
                            <div class="card-body p-2">
                                <div class="d-flex align-items-end gap-1 overflow-auto py-1" style="min-height: 120px;">
                                    <div v-for="hour in metrics.hourlyTraffic" :key="hour.hour" class="text-center flex-fill" style="min-width: 42px;">
                                        <div class="d-flex flex-column justify-content-end" style="height: 80px;">
                                            <div class="bg-primary rounded-top mx-auto" :style="{ height: getBarHeight(hour.requests) + '%', width: '12px' }" :title="hour.requests + ' requests'"></div>
                                        </div>
                                        <small class="text-body-secondary d-block mt-1" style="font-size: 0.6rem;">{{ hour.hour }}</small>
                                        <span class="badge bg-body-secondary text-body" style="font-size: 0.55rem;">{{ hour.requests }}</span>
                                    </div>
                                    <div v-if="!metrics.hourlyTraffic || metrics.hourlyTraffic.length === 0" class="w-100 text-center text-muted py-4 small">
                                        Waiting for hourly aggregated traffic...
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Live Transaction Telemetry Feed & Aspire Deep Links -->
                <div class="card border shadow-sm rounded-3 bg-body mb-3">
                    <div class="card-header bg-transparent border-bottom py-2 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0 text-body fs-6">
                            <i class="fas fa-stream text-primary me-2"></i>Live Transaction Feed (OpenTelemetry)
                        </h6>
                        <span class="badge rounded-pill px-2 py-1" :class="connectionStatusBadge" style="font-size: 0.68rem;">
                            <i class="fas fa-circle fa-xs me-1"></i>{{ connectionStatusText }}
                        </span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 text-sm">
                            <thead>
                                <tr class="text-muted text-xs text-uppercase bg-body-tertiary">
                                    <th style="width: 10%">Time</th>
                                    <th style="width: 18%">Transaction ID</th>
                                    <th style="width: 25%">Trace ID (Aspire)</th>
                                    <th style="width: 25%">Endpoint</th>
                                    <th style="width: 10%">Latency</th>
                                    <th style="width: 12%">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="item in metrics.recentLogs" :key="item.id">
                                    <td><small class="text-body-secondary">{{ item.requestDate }}</small></td>
                                    <td>
                                        <span class="fw-semibold text-body" v-if="item.transactionId">{{ item.transactionId }}</span>
                                        <span class="text-muted" v-else>—</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            <code class="small text-truncate" style="max-width: 140px;">{{ item.traceId }}</code>
                                            <a :href="getAspireTraceUrl(item.traceId)"
                                               target="_blank"
                                               class="btn btn-outline-secondary btn-xs py-0 px-1"
                                               title="Inspect in .NET Aspire Dashboard">
                                                <i class="fas fa-external-link-alt" style="font-size: 0.65rem;"></i>
                                            </a>
                                        </div>
                                    </td>
                                    <td><small class="text-truncate d-inline-block text-body" style="max-width: 190px;" :title="item.uri">{{ item.uri }}</small></td>
                                    <td><small class="text-body-secondary">{{ item.latencyMs }} ms</small></td>
                                    <td>
                                        <span class="badge rounded-pill" :class="getStatusBadge(item.responseCode)">
                                            {{ item.responseCode }}
                                        </span>
                                    </td>
                                </tr>
                                <tr v-if="!metrics.recentLogs || metrics.recentLogs.length === 0">
                                    <td colspan="6" class="text-center text-muted py-4 small">Waiting for transaction events...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- System Exceptions List -->
                <div class="card border shadow-sm rounded-3 bg-body" v-if="metrics.recentExceptions && metrics.recentExceptions.length > 0">
                    <div class="card-header bg-transparent border-bottom py-2">
                        <h6 class="fw-bold mb-0 text-danger fs-6">
                            <i class="fas fa-bug me-2"></i>Recent System Exceptions
                        </h6>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush mb-0">
                            <li v-for="ex in metrics.recentExceptions" :key="ex.id" class="list-group-item bg-transparent border-bottom px-3 py-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">{{ ex.moduleName }}</span>
                                    <small class="text-body-secondary">{{ ex.time }}</small>
                                </div>
                                <small class="text-body d-block text-truncate" :title="ex.message">{{ ex.message }}</small>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .btn-xs {
        padding: 0.15rem 0.35rem;
        font-size: 0.72rem;
        line-height: 1.2;
    }

    .dark-mode .card,
    [data-bs-theme="dark"] .card {
        background-color: #1c2128 !important;
        border-color: #30363d !important;
    }

    .dark-mode .bg-body-secondary,
    [data-bs-theme="dark"] .bg-body-secondary {
        background-color: #21262d !important;
        border-color: #30363d !important;
    }

    .dark-mode .bg-body-tertiary,
    [data-bs-theme="dark"] .bg-body-tertiary {
        background-color: #161b22 !important;
        border-color: #30363d !important;
    }

    .dark-mode .table,
    [data-bs-theme="dark"] .table {
        color: #c9d1d9 !important;
        border-color: #30363d !important;
    }

    .dark-mode .table thead tr,
    [data-bs-theme="dark"] .table thead tr {
        background-color: #161b22 !important;
        color: #8b949e !important;
    }

    .dark-mode .table td,
    [data-bs-theme="dark"] .table td {
        border-color: #30363d !important;
        background-color: transparent !important;
    }

    .dark-mode .list-group-item,
    [data-bs-theme="dark"] .list-group-item {
        border-color: #30363d !important;
    }
</style>

@section scripts { 
    <script src="~/js/app/directive/common.js" asp-append-version="true"></script>
    <script src="~/js/app/services/user.js" asp-append-version="true"></script>
    <script src="~/js/app/services/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/app/controller/home.js" asp-append-version="true"></script>
}