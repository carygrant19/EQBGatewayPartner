                                        <span class="badge bg-info text-dark mt-1" v-if="viewData.authProviderId"><i class="fas fa-shield-alt me-1"></i>JWT</span>
                                        <span class="badge bg-light text-dark border mt-1" v-if="!viewData.requireApiKey && !viewData.authProviderId">Public</span>
                                    </div>
                                </div>
