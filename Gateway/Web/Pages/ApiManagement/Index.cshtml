                                <h5 class="modal-title fs-6 fw-bold mb-0">{{ viewData.name }}</h5>
                                <span class="badge bg-success ms-2" v-if="viewData.isActive"><i class="fas fa-check-circle me-1"></i>Active</span>
                                <span class="badge bg-secondary ms-2" v-else><i class="fas fa-ban me-1"></i>Disabled</span>
