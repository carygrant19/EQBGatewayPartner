@page
@model Gateway.Web.Pages.ApiManagement.IndexModel
@{
    ViewData["Title"] = Model.PageTitle;
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div id="controller">
    <section class="content-header py-3">
        <div class="container-fluid">
            <div class="row mb-2 align-items-center">
                <div class="col-sm-6">
                    <h1><button type="button" class="btn btn-md" onclick="GoBack();"><i class="nav-icon fa fa-lg fa-arrow-circle-left text-secondary"></i></button> <b class="text-lg">@ViewData["Title"]</b> </h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end mb-0 text-xs">
                        @foreach (var item in Model.PageUrl.Split('/'))
                        {
                            if (!String.IsNullOrEmpty(@item))
                            {
                                <li class="breadcrumb-item text-capitalize">@item</li>
                            }
                        }
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid" autocomplete="off">
            <div class="row">
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-body p-3">
                            <!-- Search & Action Bar -->
                            <div class="row mb-3 g-2 align-items-center justify-content-between">
                                <div class="col-12 col-md-5">
                                    <div class="input-group input-group-sm">
                                        @if (Model.Permission.Contains("[SEARCH]"))
                                        {
                                            <input type="text" id="searchDescription" class="form-control" placeholder="Search route name, path, or code..." v-model="search.keyword" v-on:keypress="KeyPress_Search" />
                                            <button type="button" class="btn btn-dark" v-on:click="Search()">
                                                <i class="fas fa-search me-1"></i> Search
                                            </button>
                                        }
                                    </div>
                                </div>
                                <div class="col-auto d-flex gap-2">
                                    @if (Model.Permission.Contains("[EDIT]") || Model.Permission.Contains("[ADD]"))
                                    {
                                        <button type="button" class="btn btn-success btn-sm fw-medium px-3" v-on:click="Publish()" title="Publish all changes to live Proxy Gateway">
                                            <i class="fas fa-paper-plane me-1"></i> Publish Changes
                                        </button>
                                    }
                                    @if (Model.Permission.Contains("[ADD]"))
                                    {
                                        <button type="button" class="btn btn-dark btn-sm fw-medium px-3" data-bs-toggle="modal" data-bs-target="#formModal" v-on:click="Add()">
                                            <i class="fas fa-plus me-1"></i> Add Route
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Records Table -->
                            <div class="row">
                                <div class="col-12" v-show="!show_table">
                                    <div class="text-center text-muted py-5">
                                        <i class="fas fa-inbox fa-2x mb-2 opacity-50"></i>
                                        <div>No record(s) found</div>
                                    </div>
                                </div>

                                <div class="col-12" v-show="show_table">
                                    <div class="d-flex align-items-center gap-2 mb-3 text-xs text-muted">
                                        <span>Show</span>
                                        <select v-model="params.pageSize" class="form-select form-select-sm w-auto" v-on:change="ItemCountChange()">
                                            <option v-for="pageSize in pageSizeArray" :key="pageSize" :value="pageSize">{{ pageSize }}</option>
                                        </select>
                                        <span>records</span>
                                    </div>

                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0 text-sm border-top">
                                            <thead class="table-light">
                                                <tr class="text-muted text-xs text-uppercase fw-semibold">
                                                    <th style="width:11%">Code <i v-bind:class="['fas', SortClass('Code')]" class="ms-1 cursor-pointer" v-on:click="Sort('Code')"></i></th>
                                                    <th style="width:18%">Name <i v-bind:class="['fas', SortClass('Name')]" class="ms-1 cursor-pointer" v-on:click="Sort('Name')"></i></th>
                                                    <th style="width:10%">Type</th>
                                                    <th style="width:16%">Auth</th>
                                                    <th style="width:16%">Upstream</th>
                                                    <th style="width:17%">Downstream</th>
                                                    <th class="text-center" style="width:12%">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr v-for="record in records" :key="record.id">
                                                    <td><code class="fw-semibold text-dark">{{ record.code }}</code></td>
                                                    <td>
                                                        <div class="fw-medium">{{ record.name }}</div>
                                                        <small class="text-muted" v-if="record.categoryName">
                                                            <i class="fas fa-folder me-1 opacity-75"></i>{{ record.categoryName }}
                                                        </small>
                                                    </td>
                                                    <td>
                                                        <span class="badge rounded-pill bg-light text-dark border" v-if="record.integrationType === 'PROXY'">PROXY</span>
                                                        <span class="badge rounded-pill bg-light text-dark border" v-else-if="record.integrationType === 'INTERNAL_AUTH'">AUTH</span>
                                                        <span class="badge rounded-pill bg-light text-dark border" v-else-if="record.integrationType === 'MOCK'">MOCK</span>
                                                    </td>
                                                    <td>
                                                        <div class="d-flex flex-wrap gap-1">
                                                            <span class="badge rounded-pill bg-light text-dark border" v-if="record.requireApiKey">API Key</span>
                                                            <span class="badge rounded-pill bg-light text-dark border" v-if="record.authProviderId">JWT</span>
                                                            <span class="badge rounded-pill bg-light text-dark border" v-if="record.outboundAuthProfileId">Outbound</span>
                                                            <span class="badge rounded-pill bg-light text-muted border" v-if="!record.requireApiKey && !record.authProviderId && !record.outboundAuthProfileId">Public</span>
                                                        </div>
                                                    </td>
                                                    <td><code class="small">{{ record.upstreamPathTemplate }}</code></td>
                                                    <td>
                                                        <span v-if="record.integrationType === 'MOCK'" class="text-muted small">Mock Engine</span>
                                                        <span v-else-if="record.integrationType === 'INTERNAL_AUTH'" class="text-muted small">Internal Token</span>
                                                        <code class="small" v-else>{{ record.downstreamScheme }}://{{ record.downstreamPathTemplate }}</code>
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="btn-group btn-group-sm">
                                                            <button type="button" class="btn btn-outline-secondary" v-on:click="View(record)" title="View">
                                                                <i class="fas fa-eye"></i>
                                                            </button>
                                                            @if (Model.Permission.Contains("[EDIT]"))
                                                            {
                                                                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#formModal" v-on:click="Edit(record)" title="Edit">
                                                                    <i class="fas fa-pen"></i>
                                                                </button>
                                                            }
                                                            @if (Model.Permission.Contains("[DELETE]"))
                                                            {
                                                                <button type="button" class="btn btn-outline-danger" v-on:click="Delete(record)" v-if="record.isActive" title="Disable">
                                                                    <i class="fas fa-ban"></i>
                                                                </button>
                                                            }
                                                            @if (Model.Permission.Contains("[RESTORE]"))
                                                            {
                                                                <button type="button" class="btn btn-outline-success" v-on:click="Restore(record)" v-if="!record.isActive" title="Restore">
                                                                    <i class="fas fa-undo"></i>
                                                                </button>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="mt-3">
                                        <ul id="sync-pagination" class="pagination-sm float-end mb-0"></ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== FORM MODAL (6 SEPARATE TABS) ==================== -->
            @if (Model.Permission.Contains("[ADD]") || Model.Permission.Contains("[EDIT]"))
            {
                <div id="formModal" class="modal fade" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
                    <div class="modal-dialog modal-xl modal-dialog-scrollable">
                        <form name="formModal" id="dataForm" method="post" autocomplete="off" data-parsley-validate="">
                            <div class="modal-content border-0 shadow">
                                <div class="modal-header border-bottom py-3 bg-dark text-white">
                                    <h5 class="modal-title fw-semibold">
                                        <i v-bind:class="['fas', ActionModeIcon()]" class="me-2"></i>
                                        {{ actionMode }} Gateway Route
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>

                                <div class="modal-body p-0">
                                    <div class="row g-0">
                                        <!-- Side Navigation Sidebar (6 Tabs) -->
                                        <div class="col-md-3 border-end bg-light">
                                            <div class="nav flex-column nav-pills p-3 gap-1" id="v-pills-tab" role="tablist">
                                                <button class="nav-link text-start active d-flex justify-content-between align-items-center"
                                                        id="v-basic-tab" data-bs-toggle="pill" data-bs-target="#v-basic" type="button">
                                                    <span><i class="fas fa-route me-2 opacity-75"></i>General & Routing</span>
                                                    <span class="badge bg-danger rounded-pill" v-if="tabErrors.basic > 0">{{ tabErrors.basic }}</span>
                                                </button>

                                                <button class="nav-link text-start d-flex justify-content-between align-items-center"
                                                        id="v-inbound-tab" data-bs-toggle="pill" data-bs-target="#v-inbound" type="button">
                                                    <span><i class="fas fa-shield-alt me-2 opacity-75"></i>Inbound Auth</span>
                                                    <span class="badge bg-danger rounded-pill" v-if="tabErrors.inbound > 0">{{ tabErrors.inbound }}</span>
                                                </button>

                                                <button class="nav-link text-start d-flex justify-content-between align-items-center"
                                                        id="v-outbound-tab" data-bs-toggle="pill" data-bs-target="#v-outbound" type="button"
                                                        v-show="formData.integrationType === 'PROXY'">
                                                    <span><i class="fas fa-server me-2 opacity-75"></i>Outbound & Targets</span>
                                                    <span class="badge bg-danger rounded-pill" v-if="tabErrors.outbound > 0">{{ tabErrors.outbound }}</span>
                                                </button>

                                                <button class="nav-link text-start d-flex justify-content-between align-items-center"
                                                        id="v-transform-tab" data-bs-toggle="pill" data-bs-target="#v-transform" type="button"
                                                        v-show="formData.integrationType === 'PROXY'">
                                                    <span><i class="fas fa-exchange-alt me-2 opacity-75"></i>Header Transforms</span>
                                                    <span class="badge bg-danger rounded-pill" v-if="tabErrors.transform > 0">{{ tabErrors.transform }}</span>
                                                </button>

                                                <button class="nav-link text-start d-flex justify-content-between align-items-center"
                                                        id="v-resilience-tab" data-bs-toggle="pill" data-bs-target="#v-resilience" type="button">
                                                    <span><i class="fas fa-heartbeat me-2 opacity-75"></i>Resilience & Mock</span>
                                                    <span class="badge bg-danger rounded-pill" v-if="tabErrors.resilience > 0">{{ tabErrors.resilience }}</span>
                                                </button>

                                                <button class="nav-link text-start d-flex justify-content-between align-items-center"
                                                        id="v-traffic-tab" data-bs-toggle="pill" data-bs-target="#v-traffic" type="button">
                                                    <span><i class="fas fa-tachometer-alt me-2 opacity-75"></i>Traffic & Schedule</span>
                                                    <span class="badge bg-danger rounded-pill" v-if="tabErrors.traffic > 0">{{ tabErrors.traffic }}</span>
                                                </button>
                                            </div>

                                            <div class="alert alert-light border text-muted small mx-3 mt-2" v-if="totalErrors > 0">
                                                <i class="fas fa-exclamation-circle me-1 text-danger"></i>
                                                <strong>{{ totalErrors }}</strong> required field(s) remaining
                                            </div>
                                        </div>

                                        <!-- Tab Content Panes (6 Tab Panes) -->
                                        <div class="col-md-9 p-4">
                                            <div class="tab-content" id="v-pills-tabContent">

                                                <!-- TAB 1: General & Routing -->
                                                <div class="tab-pane fade show active" id="v-basic">
                                                    <h6 class="fw-semibold text-dark mb-3 pb-2 border-bottom">Route Definition</h6>
                                                    <div class="row g-3">
                                                        <div class="col-md-4">
                                                            <label class="form-label required small fw-medium">Route Code</label>
                                                            <input type="text" class="form-control form-control-sm text-uppercase" name="Code" v-model="formData.code" :disabled="disableControl.code" data-parsley-required-field />
                                                        </div>
                                                        <div class="col-md-5">
                                                            <label class="form-label required small fw-medium">Route Name</label>
                                                            <input type="text" class="form-control form-control-sm" name="Name" v-model="formData.name" data-parsley-required-field />
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label class="form-label required small fw-medium">Category</label>
                                                            <select class="form-select form-select-sm" name="Category" v-model="formData.categoryId" data-parsley-required-field>
                                                                <option :value="null" disabled>Select Category</option>
                                                                <option v-for="cat in categories" :key="cat.id" :value="cat.id">{{ cat.name }}</option>
                                                            </select>
                                                        </div>

                                                        <div class="col-md-5">
                                                            <label class="form-label required small fw-medium">Integration Type</label>
                                                            <select class="form-select form-select-sm fw-medium" v-model="formData.integrationType">
                                                                <option value="PROXY">PROXY — Reverse Proxy</option>
                                                                <option value="INTERNAL_AUTH">INTERNAL_AUTH — JWT Issuer</option>
                                                                <option value="MOCK">MOCK — Static Response</option>
                                                            </select>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label class="form-label small fw-medium">API Version</label>
                                                            <input type="text" class="form-control form-control-sm" v-model="formData.apiVersion" placeholder="v1" />
                                                        </div>
                                                        <div class="col-md-4 d-flex align-items-end">
                                                            <div class="form-check form-switch">
                                                                <input class="form-check-input" type="checkbox" id="chkActive" v-model="formData.isActive">
                                                                <label class="form-check-label small fw-medium" for="chkActive">Is Active</label>
                                                            </div>
                                                        </div>

                                                        <!-- Wildcard Switch -->
                                                        <div class="col-12">
                                                            <div class="border rounded bg-light p-3">
                                                                <div class="form-check form-switch mb-0">
                                                                    <input class="form-check-input" type="checkbox" id="chkCatchAll" v-model="formData.enableCatchAll">
                                                                    <label class="form-check-label fw-medium" for="chkCatchAll">
                                                                        Enable Sub-path Forwarding (Wildcard)
                                                                    </label>
                                                                </div>
                                                                <small class="text-muted d-block mt-1" style="margin-left: 2.2rem;">
                                                                    Appends <code>/{**catch-all}</code> so nested paths are forwarded safely.
                                                                </small>
                                                            </div>
                                                        </div>

                                                        <!-- HTTP Methods -->
                                                        <div class="col-12">
                                                            <label class="form-label required small fw-medium d-block">Allowed HTTP Methods</label>
                                                            <div class="d-flex flex-wrap gap-2 p-2 border rounded bg-light">
                                                                <div v-for="method in availableMethods" :key="method" class="form-check form-check-inline mb-0">
                                                                    <input class="form-check-input" type="checkbox" :id="'method_' + method" :value="method" v-model="selectedMethods">
                                                                    <label class="form-check-label user-select-none" :for="'method_' + method">
                                                                        <span class="badge rounded-pill px-2 py-1" :class="getMethodBadgeClass(method)">{{ method }}</span>
                                                                    </label>
                                                                </div>
                                                            </div>
                                                            <small class="text-danger" v-if="selectedMethods.length === 0">
                                                                <i class="fas fa-exclamation-circle me-1"></i>At least one method is required
                                                            </small>
                                                        </div>

                                                        <div class="col-12">
                                                            <label class="form-label small fw-medium">Description</label>
                                                            <input type="text" class="form-control form-control-sm" v-model="formData.description" />
                                                        </div>

                                                        <div class="col-md-6">
                                                            <label class="form-label required small fw-medium">Upstream Path Template</label>
                                                            <div class="input-group input-group-sm">
                                                                <input type="text" class="form-control" v-model="formData.upstreamBase" placeholder="/api/v1/resource" data-parsley-required-field />
                                                                <span class="input-group-text bg-white text-muted border" v-if="formData.enableCatchAll">/{**catch-all}</span>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6" v-show="formData.integrationType === 'PROXY'">
                                                            <label class="form-label required small fw-medium">Downstream Path Template</label>
                                                            <div class="input-group input-group-sm">
                                                                <input type="text" class="form-control" v-model="formData.downstreamBase" placeholder="/target-api" :data-parsley-required-field="formData.integrationType === 'PROXY'" />
                                                                <span class="input-group-text bg-white text-muted border" v-if="formData.enableCatchAll">/{**catch-all}</span>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-4" v-show="formData.integrationType === 'PROXY'">
                                                            <label class="form-label required small fw-medium">Downstream Scheme</label>
                                                            <select class="form-select form-select-sm" v-model="formData.downstreamScheme">
                                                                <option value="https">https</option>
                                                                <option value="http">http</option>
                                                            </select>
                                                        </div>

                                                        <div class="col-md-8 d-flex align-items-center gap-4 mt-2" v-show="formData.integrationType === 'PROXY'">
                                                            <div class="form-check form-switch">
                                                                <input class="form-check-input" type="checkbox" id="chkStripPath" v-model="formData.stripPath">
                                                                <label class="form-check-label small fw-medium" for="chkStripPath">Strip Prefix Path</label>
                                                            </div>
                                                            <div class="form-check form-switch">
                                                                <input class="form-check-input" type="checkbox" id="chkPreserveHost" v-model="formData.preserveHostHeader">
                                                                <label class="form-check-label small fw-medium" for="chkPreserveHost">Preserve Host Header</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- TAB 2: Inbound Auth -->
                                                <div class="tab-pane fade" id="v-inbound">
                                                    <h6 class="fw-semibold text-dark mb-3 pb-2 border-bottom">Inbound Authentication</h6>
                                                    <div class="row g-3">
                                                        <div class="col-md-6">
                                                            <div class="p-3 border rounded bg-light">
                                                                <div class="form-check form-switch mb-1">
                                                                    <input class="form-check-input" type="checkbox" id="chkApiKey" v-model="formData.requireApiKey">
                                                                    <label class="form-check-label fw-medium" for="chkApiKey">Require API Key</label>
                                                                </div>
                                                                <small class="text-muted">Enforces X-Api-Key / X-Client-Id at the edge</small>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <label class="form-label small fw-medium">Inbound Auth Provider (JWT)</label>
                                                            <select class="form-select form-select-sm" v-model="formData.authProviderId">
                                                                <option :value="null">— No JWT (Public) —</option>
                                                                <option v-for="provider in authProviders" :key="provider.id || provider.Id" :value="provider.id || provider.Id">
                                                                    {{ provider.name || provider.Name }} ({{ provider.code || provider.Code }})
                                                                </option>
                                                            </select>
                                                        </div>

                                                        <!-- Clients -->
                                                        <div class="col-12">
                                                            <label class="form-label small fw-medium">
                                                                <i class="fas fa-users me-1 text-muted"></i> Authorized Inbound Clients
                                                            </label>
                                                            <div class="d-flex flex-wrap gap-2 mb-2 p-2 border rounded bg-light" style="min-height:42px;">
                                                                <template v-if="selectedClientObjects.length === 0">
                                                                    <span class="text-muted small align-self-center">No clients restricted — any registered client may access</span>
                                                                </template>
                                                                <span v-for="c in selectedClientObjects" :key="c.id"
                                                                      class="badge bg-white text-dark border d-inline-flex align-items-center gap-1 px-2 py-1 rounded-pill">
                                                                    {{ c.name }} <small class="text-muted">({{ c.code }})</small>
                                                                    <button type="button" class="btn-close ms-1" style="font-size:0.55rem;"
                                                                            v-on:click="RemoveClient(c.id)" title="Remove"></button>
                                                                </span>
                                                            </div>
                                                            <div class="input-group input-group-sm" style="max-width:440px;">
                                                                <select class="form-select" v-model="clientToAdd">
                                                                    <option :value="null" disabled>Select client to authorize…</option>
                                                                    <option v-for="client in availableClientsToAdd"
                                                                            :key="client.id || client.Id"
                                                                            :value="client.id || client.Id">
                                                                        {{ client.name || client.Name }} ({{ client.code || client.Code }})
                                                                    </option>
                                                                </select>
                                                                <button type="button" class="btn btn-outline-primary" :disabled="!clientToAdd" v-on:click="AddClient()">
                                                                    <i class="fas fa-plus me-1"></i>Add
                                                                </button>
                                                            </div>
                                                            <small class="text-muted d-block mt-1">Leave empty to allow any registered client.</small>
                                                        </div>
                                                    </div>

                                                    <hr class="my-4" />

                                                    <!-- IP Rules -->
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <span class="fw-semibold small mb-0">IP Security Rules</span>
                                                        <button type="button" class="btn btn-sm btn-outline-primary flex-shrink-0" v-on:click="AddIpRule()">
                                                            <i class="fas fa-plus me-1"></i>Add Rule
                                                        </button>
                                                    </div>
                                                    <div class="table-responsive">
                                                        <table class="table table-sm table-bordered mb-0">
                                                            <thead class="table-light">
                                                                <tr class="small text-muted">
                                                                    <th>IP / Range / localhost</th>
                                                                    <th style="width:20%">Rule</th>
                                                                    <th>Description</th>
                                                                    <th style="width:8%" class="text-center"></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr v-for="(rule, index) in formData.ipRules" :key="index">
                                                                    <td><input type="text" class="form-control form-control-sm" v-model="rule.ipAddressOrRange" placeholder="192.168.1.1 or localhost" data-parsley-required-field /></td>
                                                                    <td>
                                                                        <select class="form-select form-select-sm" v-model="rule.ruleType">
                                                                            <option value="Allow">Allow</option>
                                                                            <option value="Deny">Deny</option>
                                                                        </select>
                                                                    </td>
                                                                    <td><input type="text" class="form-control form-control-sm" v-model="rule.description" /></td>
                                                                    <td class="text-center">
                                                                        <button type="button" class="btn btn-sm btn-outline-danger" v-on:click="RemoveIpRule(index)">
                                                                            <i class="fas fa-trash"></i>
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                                <tr v-if="formData.ipRules.length === 0">
                                                                    <td colspan="4" class="text-center text-muted small py-3">No IP rules defined</td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>

                                                <!-- TAB 3: Outbound & Targets (PROXY only) -->
                                                <div class="tab-pane fade" id="v-outbound">
                                                    <h6 class="fw-semibold text-dark mb-3 pb-2 border-bottom">Outbound Auth & Target Hosts</h6>

                                                    <div class="row g-3 mb-4">
                                                        <div class="col-12">
                                                            <label class="form-label small fw-medium">
