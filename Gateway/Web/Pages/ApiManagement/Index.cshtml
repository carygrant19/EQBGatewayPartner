                                                    </thead>
                                                    <tbody>
                                                        <tr v-for="r in viewData.ipRules" :key="r.id">
                                                            <td><code>{{ r.ipAddressOrRange }}</code></td>
                                                            <td>
                                                                <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle" v-if="r.ruleType === 'Allow'">Allow</span>
                                                                <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle" v-else>Deny</span>
                                                            </td>
                                                            <td>{{ r.description || '—' }}</td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Mock -->
                                    <div class="tab-pane fade" id="vtab-mock" v-if="viewData.integrationType === 'MOCK'">
                                        <div class="mb-2">
                                            <span class="fw-medium me-2">HTTP Status:</span>
                                            <code>{{ viewData.mockResponseCode || 200 }}</code>
                                        </div>
                                        <label class="text-muted small text-uppercase fw-medium d-block mb-1">Response Body</label>
                                        <pre class="bg-dark text-success p-3 rounded mb-0 font-monospace small"><code>{{ viewData.mockResponseBody }}</code></pre>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer border-top py-2">
                            <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

