@page
@model Gateway.Web.Pages.Reports.TransactionLogsModel
@{
    ViewData["Title"] = "API Transaction Report";
}

<section class="content-header py-2 mb-2">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <span class="fs-4 fw-bold text-body">
                    <i class="fas fa-file-invoice me-2 text-primary"></i>API Transaction & Traffic Report
                </span>
            </div>
            <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                <ol class="breadcrumb float-sm-end mb-0 text-xs">
                    @foreach (var item in Model.PageUrl.Split('/'))
                    {
                        if (!String.IsNullOrEmpty(@item))
                        {
                            <li class="breadcrumb-item text-capitalize">@item</li>
                        }
                    }
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid px-3" id="controller" autocomplete="off">
        <!-- Search & Filter Card -->
        <div class="card border shadow-sm rounded-3 bg-body mb-3">
            <div class="card-header bg-transparent border-bottom py-2">
                <h6 class="fw-bold mb-0 text-body fs-6">
                    <i class="fas fa-filter text-primary me-2"></i>Search & Filter Criteria
                </h6>
            </div>
            <div class="card-body p-3">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-3 col-xl-2">
                        <label class="form-label small text-body-secondary mb-1">Start Date & Time</label>
                        <input type="datetime-local" class="form-control form-control-sm" v-model="search.startDate" />
                    </div>
                    <div class="col-12 col-md-3 col-xl-2">
                        <label class="form-label small text-body-secondary mb-1">End Date & Time</label>
                        <input type="datetime-local" class="form-control form-control-sm" v-model="search.endDate" />
                    </div>
                    <div class="col-12 col-md-3 col-xl-2">
                        <label class="form-label small text-body-secondary mb-1">Route / Endpoint</label>
                        <select class="form-select form-select-sm" v-model="search.routeId">
                            <option value="">All Routes</option>
                            <option v-for="r in routes" :key="r.id" :value="r.id">{{ r.code }} - {{ r.name }}</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3 col-xl-2">
                        <label class="form-label small text-body-secondary mb-1">HTTP Status</label>
                        <select class="form-select form-select-sm" v-model="search.statusCategory">
                            <option value="ALL">All Statuses</option>
                            <option value="2XX">2xx (Success)</option>
                            <option value="4XX">4xx (Client Error)</option>
                            <option value="5XX">5xx (Server Error)</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4 col-xl-2">
                        <label class="form-label small text-body-secondary mb-1">Txn Ref / ID</label>
                        <input type="text" class="form-control form-control-sm" placeholder="e.g. 1234567890" v-model="search.transactionId" v-on:keyup.enter="Search()" />
                    </div>
                    <div class="col-12 col-md-8 col-xl-2">
                        <label class="form-label small text-body-secondary mb-1">Trace ID / URI</label>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control" placeholder="TraceId or URI..." v-model="search.traceOrUri" v-on:keyup.enter="Search()" />
                            <button class="btn btn-primary" type="button" v-on:click="Search()" title="Search">
                                <i class="fas fa-search"></i>
                            </button>
                            <button class="btn btn-outline-secondary" type="button" v-on:click="ResetFilters()" title="Reset">
                                <i class="fas fa-undo"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary KPI Strip -->
        <div class="row g-2 mb-3">
            <div class="col-6 col-md-3">
                <div class="p-2 px-3 border rounded-3 bg-body shadow-sm d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-body-secondary d-block text-uppercase fw-semibold" style="font-size:0.65rem;">Total Matched</small>
                        <span class="fs-5 fw-bold text-body">{{ totalRecord }}</span>
                    </div>
                    <i class="fas fa-list-ol text-primary opacity-75"></i>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-2 px-3 border rounded-3 bg-body shadow-sm d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-body-secondary d-block text-uppercase fw-semibold" style="font-size:0.65rem;">Successful (2xx)</small>
                        <span class="fs-5 fw-bold text-success">{{ summary.totalSuccess2xx }}</span>
                    </div>
                    <i class="fas fa-check-circle text-success opacity-75"></i>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-2 px-3 border rounded-3 bg-body shadow-sm d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-body-secondary d-block text-uppercase fw-semibold" style="font-size:0.65rem;">Errors (4xx / 5xx)</small>
                        <span class="fs-5 fw-bold text-danger">{{ summary.totalError4xx5xx }}</span>
                    </div>
                    <i class="fas fa-exclamation-triangle text-danger opacity-75"></i>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-2 px-3 border rounded-3 bg-body shadow-sm d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-body-secondary d-block text-uppercase fw-semibold" style="font-size:0.65rem;">Avg Latency</small>
                        <span class="fs-5 fw-bold text-info">{{ summary.averageLatencyMs }} ms</span>
                    </div>
                    <i class="fas fa-stopwatch text-info opacity-75"></i>
                </div>
            </div>
        </div>

        <!-- Results Table Card -->
        <div class="card border shadow-sm rounded-3 bg-body mb-3">
            <div class="card-header bg-transparent border-bottom py-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 w-100">
                    <div class="d-flex align-items-center gap-2 small text-body-secondary">
                        <span>Show</span>
                        <select v-model="params.pageSize" class="form-select form-select-sm w-auto" v-on:change="ItemCountChange()">
                            <option v-for="pageSize in pageSizeArray" :key="pageSize" :value="pageSize">{{ pageSize }}</option>
                        </select>
                        <span>records (Total: <b>{{ totalRecord }}</b>)</span>
                    </div>
                    <button type="button" class="btn btn-success btn-sm w-auto px-3" style="width: auto !important;" v-on:click="ExportCsv()" :disabled="totalRecord === 0">
                        <i class="fas fa-file-csv me-1"></i>Export CSV / Excel
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-sm">
                    <thead>
                        <tr class="text-muted text-xs text-uppercase bg-body-tertiary">
                            <th style="width: 14%; cursor: pointer;" v-on:click="Sort('RequestDate')">
                                Timestamp <i class="fas ms-1" :class="SortClass('RequestDate')"></i>
                            </th>
                            <th style="width: 7%; cursor: pointer;" v-on:click="Sort('HttpMethod')">
                                Method <i class="fas ms-1" :class="SortClass('HttpMethod')"></i>
                            </th>
                            <th style="width: 12%">Txn Ref</th>
                            <th style="width: 20%; cursor: pointer;" v-on:click="Sort('TraceId')">
                                Trace ID <i class="fas ms-1" :class="SortClass('TraceId')"></i>
                            </th>
                            <th style="width: 14%">Route</th>
                            <th style="width: 18%; cursor: pointer;" v-on:click="Sort('Uri')">
                                Endpoint / Status <i class="fas ms-1" :class="SortClass('Uri')"></i>
                            </th>
                            <th style="width: 7%">Latency</th>
                            <th style="width: 8%" class="text-center">Inspect</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="item in records" :key="item.id">
                            <td><small class="text-body-secondary">{{ $formatDateText(item.requestDate) }} {{ $formatTime(item.requestDate) }}</small></td>
                            <td><span class="badge bg-secondary-subtle text-body border">{{ item.httpMethod }}</span></td>
                            <td>
                                <span class="fw-semibold text-body small" v-if="item.transactionId">{{ item.transactionId }}</span>
                                <span class="text-muted small" v-else>—</span>
                            </td>
                            <td>
                                <div class="d-inline-flex align-items-center gap-1">
                                    <code class="small text-truncate d-inline-block text-warning" style="max-width: 165px;" :title="item.traceId">{{ item.traceId }}</code>
                                    <button type="button" class="btn btn-link btn-xs p-0 text-body-secondary w-auto" style="width: auto !important;" v-on:click="CopyText(item.traceId)" title="Copy Trace ID">
                                        <i class="far fa-copy"></i>
                                    </button>
                                </div>
                            </td>
                            <td>
                                <span v-if="item.routeName === 'Unmapped Route'" class="badge bg-secondary-subtle text-secondary border" style="font-size: 0.68rem;">Unmapped</span>
                                <small v-else class="text-body text-truncate d-inline-block" style="max-width: 140px;" :title="item.routeName">{{ item.routeName }}</small>
                            </td>
                            <td>
                                <div class="d-inline-flex align-items-center gap-1">
                                    <span class="badge rounded-pill" :class="getStatusBadge(item.responseCode)">{{ item.responseCode }}</span>
                                    <small class="text-truncate d-inline-block text-body" style="max-width: 155px;" :title="item.uri">{{ item.uri }}</small>
                                </div>
                            </td>
                            <td><small class="text-body-secondary">{{ item.latencyMs }} ms</small></td>
                            <td class="text-center">
                                <button type="button" class="btn btn-outline-primary btn-xs py-1 px-2 w-auto" style="width: auto !important;" v-on:click="OpenTraceModal(item.traceId)">
                                    <i class="fas fa-project-diagram me-1"></i>Timeline
                                </button>
                            </td>
                        </tr>
                        <tr v-if="records.length === 0">
                            <td colspan="8" class="text-center text-muted py-5 small">No transaction records found.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-transparent border-top py-2" v-show="show_table">
                <ul id="sync-pagination" class="pagination-sm float-end mb-0"></ul>
            </div>
        </div>

        <!-- ==================== DISTRIBUTED TRACE WATERFALL MODAL ==================== -->
        <div id="traceModal" class="modal fade" tabindex="-1" data-bs-backdrop="static">
            <div class="modal-dialog modal-xl modal-dialog-scrollable" style="max-width: 92vw; width: 1300px;">
                <div class="modal-content border shadow bg-body">
                    <div class="modal-header border-bottom py-3 custom-modal-header text-white d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <i class="fas fa-project-diagram text-primary fa-lg"></i>
                            <h5 class="modal-title fw-bold text-white mb-0">Distributed Trace Waterfall</h5>
                            <span class="badge rounded-pill" :class="selectedTrace?.overallStatus === 'SUCCESS' ? 'bg-success' : 'bg-danger'">
                                {{ selectedTrace?.overallStatus || 'PENDING' }}
                            </span>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body p-3 bg-body-tertiary">
                        <div v-if="isTraceLoading" class="text-center py-5">
                            <div class="spinner-border text-primary mb-2" role="status"></div>
                            <div class="text-body-secondary small">Correlating SQL logs for Trace ID...</div>
                        </div>

                        <div v-else-if="selectedTrace">
                            <div class="row g-2 mb-3">
                                <div class="col-12 col-md-5">
                                    <div class="p-2 border rounded bg-body">
                                        <small class="text-body-secondary d-block text-uppercase fw-semibold" style="font-size:0.65rem;">Trace ID</small>
                                        <code class="small text-truncate d-block text-warning">{{ selectedTrace.traceId }}</code>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="p-2 border rounded bg-body">
                                        <small class="text-body-secondary d-block text-uppercase fw-semibold" style="font-size:0.65rem;">Start Timestamp</small>
                                        <span class="fw-semibold text-body small">{{ selectedTrace.startTime }}</span>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="p-2 border rounded bg-body">
                                        <small class="text-body-secondary d-block text-uppercase fw-semibold" style="font-size:0.65rem;">Total Latency</small>
                                        <span class="fw-bold text-primary small">{{ selectedTrace.totalDurationMs }} ms</span>
                                    </div>
                                </div>
                            </div>

                            <div class="card border shadow-sm bg-body">
                                <div class="card-header bg-transparent border-bottom py-2">
                                    <h6 class="fw-bold mb-0 text-body small">
                                        <i class="fas fa-layer-group text-secondary me-2"></i>Hop Execution Timeline ({{ selectedTrace.hops.length }} Spans)
                                    </h6>
                                </div>
                                <div class="card-body p-3">
                                    <div v-for="hop in selectedTrace.hops" :key="hop.step" class="border rounded p-3 mb-3 bg-body-secondary">
                                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span class="badge rounded-circle bg-dark text-white p-2" style="width:24px; height:24px; line-height:10px; font-size:0.7rem;">{{ hop.step }}</span>
                                                <span class="fw-bold text-body">{{ hop.title }}</span>
                                                <span class="badge bg-secondary-subtle text-body border" style="font-size:0.68rem;">{{ hop.httpMethod }}</span>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle" v-if="hop.transactionId" style="font-size:0.68rem;">
                                                    <i class="fas fa-receipt me-1"></i>Txn Ref: {{ hop.transactionId }}
                                                </span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge" :class="hop.isError ? 'bg-danger' : 'bg-success'">{{ hop.status }}</span>
                                                <span class="fw-semibold text-body small"><i class="fas fa-stopwatch me-1 text-muted"></i>{{ hop.durationMs }} ms</span>
                                                <small class="text-body-secondary"><i class="fas fa-clock me-1"></i>{{ hop.timestamp }}</small>
                                            </div>
                                        </div>

                                        <div class="progress mb-2" style="height: 6px; background-color: rgba(0,0,0,0.06);">
                                            <div class="progress-bar"
                                                 :class="hop.isError ? 'bg-danger' : 'bg-primary'"
                                                 role="progressbar"
                                                 :style="{ width: getWaterfallWidth(hop.durationMs, selectedTrace.totalDurationMs) + '%' }">
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <small class="text-body-secondary d-block text-uppercase fw-semibold" style="font-size:0.65rem;">Endpoint / Route</small>
                                            <code class="small d-block text-truncate p-1 bg-body rounded border">{{ hop.endpoint }}</code>
                                        </div>

                                        <div class="accordion accordion-flush" :id="'acc_' + hop.step">
                                            <div class="accordion-item bg-transparent border rounded mb-1" v-if="hop.requestPayload">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed py-2 px-3 small bg-body text-body" type="button" data-bs-toggle="collapse" :data-bs-target="'#req_' + hop.step">
                                                        <i class="fas fa-arrow-right text-info me-2"></i> Request Payload
                                                    </button>
                                                </h2>
                                                <div :id="'req_' + hop.step" class="accordion-collapse collapse" :data-bs-parent="'#acc_' + hop.step">
                                                    <div class="accordion-body p-2 bg-body">
                                                        <pre class="mb-0 small font-monospace text-body-secondary p-2 bg-body-secondary rounded border" style="max-height: 200px; overflow-y: auto;"><code>{{ formatJson(hop.requestPayload) }}</code></pre>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="accordion-item bg-transparent border rounded" v-if="hop.responsePayload">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed py-2 px-3 small bg-body text-body" type="button" data-bs-toggle="collapse" :data-bs-target="'#res_' + hop.step">
                                                        <i class="fas fa-arrow-left text-success me-2"></i> Response Payload
                                                    </button>
                                                </h2>
                                                <div :id="'res_' + hop.step" class="accordion-collapse collapse" :data-bs-parent="'#acc_' + hop.step">
                                                    <div class="accordion-body p-2 bg-body">
                                                        <pre class="mb-0 small font-monospace text-body-secondary p-2 bg-body-secondary rounded border" style="max-height: 200px; overflow-y: auto;"><code>{{ formatJson(hop.responsePayload) }}</code></pre>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div v-else class="text-center py-5 text-muted">
                            <i class="fas fa-search fa-2x mb-2 opacity-50"></i>
                            <div>No correlated logs found for this Trace ID.</div>
                        </div>
                    </div>

                    <div class="modal-footer border-top py-2">
                        <button type="button" class="btn btn-secondary btn-sm w-auto" style="width: auto !important;" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .btn-xs {
        padding: 0.15rem 0.35rem;
        font-size: 0.72rem;
        line-height: 1.2;
    }

    .custom-modal-header {
        background-color: #1a1e22 !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
    }

    .dark-mode .card, [data-bs-theme="dark"] .card {
        background-color: #1c2128 !important;
        border-color: #30363d !important;
    }

    .dark-mode .bg-body-secondary, [data-bs-theme="dark"] .bg-body-secondary {
        background-color: #21262d !important;
        border-color: #30363d !important;
    }

    .dark-mode .bg-body-tertiary, [data-bs-theme="dark"] .bg-body-tertiary {
        background-color: #161b22 !important;
        border-color: #30363d !important;
    }

    .dark-mode .table, [data-bs-theme="dark"] .table {
        color: #c9d1d9 !important;
        border-color: #30363d !important;
    }

        .dark-mode .table thead tr, [data-bs-theme="dark"] .table thead tr {
            background-color: #161b22 !important;
            color: #8b949e !important;
        }

        .dark-mode .table td, [data-bs-theme="dark"] .table td {
            border-color: #30363d !important;
            background-color: transparent !important;
        }

    .dark-mode .modal-content, [data-bs-theme="dark"] .modal-content {
        background-color: #1c2128 !important;
        border-color: #30363d !important;
        color: #c9d1d9 !important;
    }
</style>

@section scripts {
    <script src="~/js/app/directive/common.js" asp-append-version="true"></script>
    <script src="~/js/app/services/report.js" asp-append-version="true"></script>
    <script src="~/js/app/controller/report/transaction-logs.js" asp-append-version="true"></script>
}