@page 
@model Gateway.Web.Pages.Application.RouteManagement.IndexModel
@{
    ViewData["Title"] = Model.PageTitle;
    var currentUrl = ViewContext.HttpContext.Request.Path;
}

<div id="controller"> 
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1><button type="button" class="btn btn-md" onclick="GoBack();"><i class="nav-icon fa fa-lg fa-arrow-circle-left text-secondary"></i></button> <b class="text-lg">@ViewData["Title"]</b> </h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        @foreach (var item in Model.PageUrl.Split('/'))
                        {
                            if (!String.IsNullOrEmpty(@item))
                            {
                                <li class="breadcrumb-item">@item</li>
                            }
                        }
                    </ol>
                </div>
            </div>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid" autocomplete="off">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-sm-12 col-md-6 col-lg-6 mb-3">
                                    <div class="input-group">
                                        @if (Model.Permission.Contains("[SEARCH]"))
                                        {
                                            <input type="text" id="searchDescription" v-on:keyup.enter="Search();" autocomplete="off" class="form-control" placeholder="Enter Batch No" v-model="search.description" data-parsley-restrict-special-characters />
                                        }
                                        @if (Model.Permission.Contains("[SEARCH]"))
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm" v-on:click="Search();">
                                                <i class="nav-icon fas fa-search"></i> Search
                                            </button>
                                        }

                                        @if (Model.Permission.Contains("[UPLOAD]"))
                                        {
                                            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#formModal" v-on:click="UploadForm">
                                                <i class="nav-icon fas fa-upload"></i> Upload
                                            </button>
                                        }
                                        @if (Model.Permission.Contains("[SEARCH]"))
                                        {
                                            <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#filterModal" v-on:click="FilterForm">
                                                <i class="nav-icon fas fa-filter"></i> Filter
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 table-responsive" v-show="!show_table">
                                    <span>No record(s) found!</span>
                                </div>
                                <div class="col-12 table-responsive" v-show="show_table">
                                    <div class="row form-group pb-3">
                                        <div class="col-auto">
                                            Show
                                        </div>
                                        <div class="col-auto">
                                            <select name="params_length"
                                                    v-model="params.pageSize"
                                                    class="form-control form-control-sm custom-select"
                                                    v-on:change="ItemCountChange()"
                                                    style="min-width: 50px;">
                                                <option v-for="(pageSize, index) in pageSizeArray" :key="pageSize" :value="pageSize">
                                                    {{ pageSize }}
                                                </option>
                                            </select>
                                        </div>
                                        <div class="col-auto">
                                            records
                                        </div>
                                    </div>
                                    <table class="table datatable fs-13">
                                        <thead class="table-light">
                                            <tr>
                                                <th width="5%">Status <i :class="['fas', SortClass('Status')]" style="cursor:pointer" v-on:click="Sort('Status')"></i></th>
                                                <th width="10%">Batch No <i :class="['fas', SortClass('BatchNo')]" style="cursor:pointer" v-on:click="Sort('BatchNo')"></i></th>
                                                <th width="20%">Batch Details </th>
                                                <th width="20%">Account Details </th>
                                                <th width="20%">Transaction Details </th>
                                                <th class="text-center" width="15%">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr v-for="record in records">
                                                <td class="align-middle">
                                                    <span class="badge" v-bind:class="getBadgeClass(record.status)" v-if="record.status">{{ record.status }}</span>
                                                </td>
                                                <td class="align-middle">{{ record.batchNo }}</td>
                                                <td class="align-middle">
                                                    <div>
                                                        <b>Branch:</b> {{ record.branchCode }} <br />
                                                        <b>Company ID:</b> {{ record.companyId }} <br />
                                                        <b>Filename:</b> {{ record.fileName }} <br />
                                                        <b>Run Schedule:</b> {{$formatDateTime(record.runSchedule) }} <br />
                                                    </div>
                                                </td>
                                                <td class="align-middle">
                                                    <div>
                                                        <b>Source:</b> {{ record.sourceAccount }} <br />
                                                        <b>Internal:</b> {{ record.internalAccount }} <br />
                                                    </div>
                                                </td>
                                                <td class="align-middle">
                                                    <div>
                                                        <b>Total Count:</b> {{$formatNumber(record.totalCount)}} <br />
                                                        <b>Total Amount:</b> {{$formatAmount(record.totalAmount)}} <br />
                                                    </div>
                                                </td>
                                                <td class="text-center align-middle">

                                                    @if (Model.Permission.Contains("[VIEW]"))
                                                    {
                                                        <button type="button" class="btn btn-success btn-sm mr-1 mx-1" v-on:click="View(record)" data-tooltip="tooltip" title="View">
                                                            <i class="fas fa-eye"></i>
                                                        </button>
                                                    }
                                                    @if (Model.Permission.Contains("[EDIT]"))
                                                    {
                                                        <button type="button" class="btn btn-info btn-sm mr-1 mx-1" data-bs-toggle="modal" data-bs-target="#formModal" v-if="record.status == 'PENDING'" v-on:click="Edit(record)" data-tooltip="tooltip" title="Edit">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                    }

                                                    @if (Model.Permission.Contains("[DELETE]"))
                                                    {
                                                        <button type="button" class="btn btn-danger btn-sm mr-1 mx-1" v-on:click="Delete(record);" v-if="!record.deleted" data-tooltip="tooltip" title="Delete">
                                                            <i class="far fa-trash-alt"></i>
                                                        </button>
                                                    }
                                                    @if (Model.Permission.Contains("[RESTORE]"))
                                                    {
                                                        <button type="button" class="btn btn-success btn-sm mr-1 mx-1" v-on:click="Restore(record);" v-if="record.deleted" data-tooltip="tooltip" title="Restore">
                                                            <i class="fas fa-undo"></i>
                                                        </button>
                                                    }
                                                    @if (Model.Permission.Contains("[DOWNLOAD]"))
                                                    {
                                                        <button type="button" class="btn btn-primary btn-sm mr-1 mx-1" v-on:click="Download(record);" data-tooltip="tooltip" title="Download">
                                                            <i class="fas fa-download"></i>
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="col-12 table-responsive" v-show="show_table">
                                    <ul id="sync-pagination" class="pagination-sm float-end"></ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        
            <div id="filterModal" class="modal fade text-sm" tabindex="-1" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-md" role="document">
                    <form name="filterModal" id="filterForm" method="post" autocomplete="off" data-parsley-validate="">
                        <div class="modal-content">
                            <div class="modal-header bg-danger">
                                <h5 class="modal-title left"> <i class="fas fa-search"> </i> Filter</h5>
                                <button type="button" class="btn-close text-light" data-bs-dismiss="modal" aria-label="Close">
                                </button>
                            </div>
                            <div class="modal-body">
                                <div class="row col">
                                    <div class="col-sm-12">
                                        <div class="form-group">
                                            <label for="Description">Branch</label>
                                            <select class="form-control custom-select"
                                                    id="searchBranch"
                                                    v-model="search.branchCode"
                                                @* data-parsley-trigger="change focusout"
                                                data-parsley-required-message="Required field"
                                                required *@>
                                                <option v-if="branches.length > 1" value="">All</option>
                                                <template v-for="branch in branches" :key="branch.id">
                                                    <option :value="branch.code">{{ branch.code }} - {{branch.description}}</option>
                                                </template>

                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-12">
                                        <div class="form-group">
                                            <label>Status</label>
                                            <select class="form-control custom-select" v-model="search.status" id="searchStatus">
                                                <option value="">All</option>
                                                <template v-if="statuses.length > 1" v-for="status in statuses">
                                                    <option :value="status">{{ status }}</option>
                                                </template>

                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-sm-12">
                                        <div class="form-group">
                                            <label>Processed Date</label>
                                            <input type="text" id="searchDate" class="form-control readonly" placeholder="Select Date" v-model="search.date" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer justify-content-end">
                                <button type="button" class="btn btn-success btn-sm" v-on:click="Filter()"><i class="nav-icon fas fa-check-circle"></i> Submit</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div> 
        </div>
    </section>
</div>
 

