                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label small fw-semibold">Rejection Response HTTP Status Code</label>
                                                        <select class="form-select" name="qos_rate_status" v-model.number="formData.rateLimitHttpStatusCode" data-parsley-trigger="change focusout" data-parsley-required="true">
                                                            <option value="429">429 - Too Many Requests (Default)</option>
                                                            <option value="403">403 - Request Forbidden Lane</option>
                                                            <option value="503">503 - Internal Service Unavailable</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-12 mt-3">
                                                        <label class="form-label small fw-semibold">Custom Quota Exhausted Text Body Message String</label>
                                                        <input type="text" class="form-control" name="qos_rate_msg" v-model="formData.rateLimitQuotaExceededMessage" placeholder="API allocation bounds breached..." data-parsley-trigger="change focusout" data-parsley-required="true" />
                                                    </div>
