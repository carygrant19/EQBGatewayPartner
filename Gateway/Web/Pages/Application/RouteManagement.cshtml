@page
@model Gateway.Web.Pages.Application.RouteManagementModel
@{
    ViewData["Title"] = Model.PageTitle;
    var currentUrl = ViewContext.HttpContext.Request.Path;
}

<style>
    #controller .nav-pills .nav-link.active {
        background-color: #0d6efd !important;
        color: #ffffff !important;
    }

    #controller .form-control.parsley-error:focus {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25) !important;
    }

    #controller .parsley-errors-list.filled {
        display: block !important;
        color: #dc3545 !important;
        font-size: 0.8rem !important;
        list-style-type: none !important;
        padding-left: 0 !important;
        margin-top: 4px !important;
        opacity: 1 !important;
        visibility: visible !important;
    }
</style>

<div id="controller">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>
                        <button type="button" class="btn btn-md" onclick="GoBack();">
                            <i class="nav-icon fa fa-lg fa-arrow-circle-left text-secondary"></i>
                        </button>
                        <b class="text-lg">@ViewData["Title"]</b>
                    </h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        @foreach (var item in Model.PageUrl.Split('/'))
                        {
                            if (!String.IsNullOrEmpty(@item))
                            {
                                <li class="breadcrumb-item">@item</li>
                            }
                        }
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid" autocomplete="off">
            <div class="row">
                <div class="col-12">
                    <div class="card shadow-sm border border-light-subtle">
                        <div class="card-body">

                            <div class="row align-items-center border-bottom pb-3 mb-3 g-2">
                                <div class="col-12 col-md-auto d-flex flex-wrap gap-2 align-items-center">
                                    @if (Model.Permission.Contains("[SEARCH]"))
                                    {
                                        <div class="input-group input-group-sm" style="width: 300px; max-width: 100%;">
                                            <input type="text" id="searchDescription" v-on:keyup.enter="Search();" autocomplete="off" class="form-control" placeholder="Search Route Code or Name..." v-model="search.codeOrName" />
                                            <button type="button" class="btn btn-outline-secondary" v-on:click="Search();">
                                                <i class="fas fa-search"></i> Search
                                            </button>
                                        </div>

                                        <button type="button" class="btn btn-danger btn-sm text-nowrap" data-bs-toggle="modal" data-bs-target="#filterModal" v-on:click="FilterForm">
                                            <i class="fas fa-filter me-1"></i> Filter
                                        </button>
                                    }

                                    @if (Model.Permission.Contains("[ADD]"))
                                    {
                                        <button type="button" class="btn btn-success btn-sm text-nowrap px-3 shadow-sm" v-on:click="Add()">
                                            <i class="fas fa-plus-circle me-1"></i> Add Route
                                        </button>
                                    }
                                </div>

                                <div class="col-12 col-md-auto ms-md-auto text-start text-md-end">
                                    <button type="button" class="btn btn-info btn-sm text-white text-nowrap px-4 fw-bold shadow-sm" v-on:click="Publish();" data-tooltip="tooltip" title="Publish Configuration Changes">
                                        <i class="fas fa-cloud-upload-alt me-1"></i> Publish
                                    </button>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12 table-responsive" v-show="!show_table">
                                    <span class="text-muted p-2 d-block">No matching proxy route configurations found!</span>
                                </div>

                                <div class="col-12 table-responsive" v-show="show_table">
                                    <div class="row form-group pb-3 align-items-center small text-muted">
                                        <div class="col-auto">Show</div>
                                        <div class="col-auto px-0">
                                            <select name="params_length" v-model="params.pageSize" class="form-control form-control-sm custom-select" v-on:change="ItemCountChange()" style="min-width: 65px;">
                                                <option v-for="(pageSize, index) in pageSizeArray" :key="pageSize" :value="pageSize">
                                                    {{ pageSize }}
                                                </option>
                                            </select>
                                        </div>
                                        <div class="col-auto">records</div>
                                    </div>

                                    <div class="table-responsive d-none d-md-block">
                                        <table class="table datatable align-middle table-hover border-top small">
                                            <thead class="table-light text-uppercase">
                                                <tr>
                                                    <th style="width: 10%;">Status</th>
                                                    <th style="width: 25%;">Route Identity</th>
                                                    <th style="width: 35%;">Routing Pipeline</th>
                                                    <th style="width: 18%;">Backend Cluster</th>
                                                    <th style="width: 12%;">Features</th>
                                                    <th class="text-center" style="width: 10%;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr v-for="record in records" :key="record.id" class="border-bottom">
                                                    <td>
                                                        <span v-if="record.isActive" class="badge bg-success px-2 py-1 fw-bold">ONLINE</span>
                                                        <span v-else class="badge bg-danger px-2 py-1 fw-bold">OFFLINE</span>

                                                        <div class="mt-2 d-flex gap-2">
                                                            <span v-if="record.isWebSocket" class="text-info font-monospace fw-bold" style="font-size: 0.7rem;" title="WebSocket Tunnel Enabled">
                                                                <i class="fas fa-bolt me-0.5"></i>WS
                                                            </span>
                                                            <span v-if="record.enableTimeLimit" class="text-warning font-monospace fw-bold" style="font-size: 0.7rem;" v-bind:title="'Schedule Active: ' + record.timeFrom + ' - ' + record.timeTo">
                                                                <i class="fas fa-clock me-0.5"></i>TIMED
                                                            </span>
                                                        </div>
                                                    </td>

                                                    <td>
                                                        <div class="d-flex flex-column justify-content-center">
                                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                                <span class="badge bg-light text-secondary border font-monospace fw-bold" style="font-size: 0.65rem;">
                                                                    {{ record.routeGroup }}
                                                                </span>
                                                                <span v-if="record.dangerousAcceptAnyServerCertificateValidator" class="badge bg-warning-subtle text-warning border border-warning-subtle font-monospace fw-bold" style="font-size: 0.65rem;">
                                                                    <i class="fas fa-shield-alt me-1"></i>BYPASS VALIDATION
                                                                </span>
                                                            </div>
                                                            <b class="text-primary font-monospace d-block mb-0.5" style="font-size: 0.9rem; letter-spacing: -0.01em;">
                                                                {{ record.code }}
                                                            </b>
                                                            <span class="text-dark fw-bold d-block lh-sm" style="font-size: 0.85rem;">
                                                                {{ record.name }}
                                                            </span>
                                                            <span class="text-wrap d-block text-truncate text-muted mt-0.5" style="max-width: 220px; font-size: 0.75rem;" v-if="record.description" v-bind:title="record.description">
                                                                {{ record.description }}
                                                            </span>
                                                        </div>
                                                    </td>

                                                    <td>
                                                        <div class="d-flex flex-column py-1">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <span class="badge font-monospace text-uppercase text-center shadow-sm" v-bind:class="getBadgeClass(record.upstreamHttpMethod)" style="width: 55px; font-size: 0.65rem; padding: 4px 0;">
                                                                    {{ record.upstreamHttpMethod || 'ANY' }}
                                                                </span>
                                                                <span class="font-monospace text-dark fw-bold" style="font-size: 0.85rem;">{{ record.upstreamPathTemplate }}</span>
                                                                <span v-if="record.upstreamHost" class="badge bg-light text-primary border border-primary-subtle font-monospace ms-auto" style="font-size: 0.65rem;" v-bind:title="'Domain Restricted: ' + record.upstreamHost">
                                                                    <i class="fas fa-globe me-1"></i>{{ record.upstreamHost }}
                                                                </span>
                                                            </div>

                                                            <div class="ps-3 my-1 d-flex align-items-center gap-2 text-black-50 border-start border-2 ms-4" style="font-size: 0.75rem; height: 14px;">
                                                                <span v-if="record.authenticationProviderKey" class="font-monospace text-primary-emphasis bg-primary-subtle border border-primary-subtle px-1.5 py-0.25 rounded fw-bold" style="font-size: 0.65rem;">
                                                                    <i class="fas fa-key me-1"></i>Enforces: {{ record.authenticationProviderKey }}
                                                                </span>
                                                                <span v-else class="font-monospace text-muted opacity-50 fw-semibold" style="font-size: 0.65rem;">
                                                                    <i class="fas fa-unlock me-1"></i>Anonymous Access Lane
                                                                </span>
                                                            </div>

                                                            <div class="d-flex align-items-center gap-2">
                                                                <span class="badge font-monospace shadow-sm text-center text-uppercase border"
                                                                      v-bind:class="{
                                                                    'bg-success-subtle text-success border-success-subtle': record.downstreamScheme === 'https',
                                                                    'bg-warning-subtle text-warning border-warning-subtle': record.downstreamScheme === 'http',
                                                                    'bg-info-subtle text-info border-info-subtle': record.downstreamScheme === 'ws' || record.downstreamScheme === 'wss'
                                                                    }"
                                                                      style="width: 55px; font-size: 0.65rem; padding: 4px 0;">
                                                                    {{ record.downstreamScheme }}
                                                                </span>
                                                                <span class="font-monospace text-dark-emphasis fw-medium" style="font-size: 0.85rem;">{{ record.downstreamPathTemplate }}</span>
                                                            </div>
                                                        </div>
                                                    </td>

                                                    <td>
                                                        <div class="font-monospace text-dark d-flex flex-column gap-1" style="font-size: 0.75rem;">
                                                            <div class="d-flex justify-content-between border-bottom pb-1" style="max-width: 180px;">
                                                                <span class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">Balancer:</span>
                                                                <b class="text-dark fw-bold">{{ record.loadBalancerType }}</b>
                                                            </div>
                                                            <div class="d-flex justify-content-between border-bottom pb-1" style="max-width: 180px;">
                                                                <span class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">Protocol:</span>
                                                                <span class="fw-medium">HTTP/{{ record.downstreamHttpVersion || '1.1' }}</span>
                                                            </div>
                                                            <div class="d-flex justify-content-between border-bottom pb-1" style="max-width: 180px;">
                                                                <span class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">Priority:</span>
                                                                <b class="text-primary fw-bold">{{ record.priority }}</b>
                                                            </div>

                                                            <div class="mt-1.5 d-flex flex-wrap gap-1">
                                                                <span v-if="record.useServiceDiscovery" class="badge bg-info-subtle text-info border border-info-subtle font-monospace fw-bold px-1.5 py-0.5">
                                                                    <i class="fas fa-cloud me-1"></i>Registry: {{ record.serviceName }}
                                                                </span>
                                                                <span v-else class="badge bg-light text-dark border font-monospace fw-bold px-1.5 py-0.5">
                                                                    <i class="fas fa-server me-1 text-black-50"></i>Nodes: {{ record.hosts ? record.hosts.length : 0 }}
                                                                </span>

                                                                <span class="badge bg-light text-dark border font-monospace fw-bold px-1.5 py-0.5" v-bind:title="(record.clients ? record.clients.length : 0) + ' Whitelisted consumers'">
                                                                    <i class="fas fa-user-shield me-1 text-black-50"></i>Clients: {{ record.clients ? record.clients.length : 0 }}
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </td>

                                                    <td>
                                                        <div class="d-flex flex-column gap-1 font-monospace" style="font-size: 0.75rem;">
                                                            <div v-if="record.enableRateLimiting" class="text-primary fw-bold">
                                                                <i class="fas fa-filter me-1.5 text-primary"></i>Rate: {{ record.rateLimit }} / {{ record.ratePeriod }}
                                                            </div>
                                                            <div v-if="record.enableCaching" class="text-success fw-bold">
                                                                <i class="fas fa-database me-1.5 text-success"></i>Cache: {{ record.cacheTtlSeconds }}s
                                                            </div>
                                                            <div v-if="record.enableQoS" class="text-warning fw-bold">
                                                                <i class="fas fa-heartbeat me-1.5 text-warning"></i>QoS: {{ record.qoSTimeoutMs }}ms
                                                            </div>
                                                            <div v-if="record.requireSignature" class="text-danger fw-bold">
                                                                <i class="fas fa-signature me-1.5 text-danger"></i>HMAC Secure
                                                            </div>
                                                            <span v-if="!record.enableRateLimiting && !record.enableCaching && !record.enableQoS && !record.requireSignature" class="text-muted font-monospace ps-1 italic">
                                                                Standard Proxy
                                                            </span>
                                                        </div>
                                                    </td>

                                                    <td class="text-center align-middle">
                                                        <div class="btn-group shadow-sm border rounded" role="group">
                                                            @if (Model.Permission.Contains("[VIEW]"))
                                                            {
                                                                <button type="button" class="btn btn-light btn-sm text-success border-0 px-2.5" v-on:click="View(record)" data-tooltip="tooltip" title="View Configurations">
                                                                    <i class="fas fa-eye"></i>
                                                                </button>
                                                            }
                                                            @if (Model.Permission.Contains("[EDIT]"))
                                                            {
                                                                <button type="button" class="btn btn-light btn-sm text-info border-start px-2.5" v-on:click="Edit(record)" data-tooltip="tooltip" title="Modify Configurations">
                                                                    <i class="fas fa-edit"></i>
                                                                </button>
                                                            }
                                                            @if (Model.Permission.Contains("[DELETE]"))
                                                            {
                                                                <button type="button" class="btn btn-light btn-sm text-danger border-start px-2.5" v-on:click="Delete(record);" v-if="record.isActive" data-tooltip="tooltip" title="Deactivate">
                                                                    <i class="far fa-trash-alt"></i>
                                                                </button>
                                                            }
                                                            @if (Model.Permission.Contains("[RESTORE]"))
                                                            {
                                                                <button type="button" class="btn btn-light btn-sm text-warning border-start px-2.5" v-on:click="Restore(record);" v-if="!record.isActive" data-tooltip="tooltip" title="Activate">
                                                                    <i class="fas fa-undo"></i>
                                                                </button>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="d-md-none d-flex flex-column gap-3">
                                        <div v-for="record in records" :key="record.id" class="card border border-light-subtle shadow-sm small">
                                            <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 px-3">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span v-if="record.isActive" class="badge bg-success font-monospace fw-bold px-2 py-0.5">ONLINE</span>
                                                    <span v-else class="badge bg-danger font-monospace fw-bold px-2 py-0.5">OFFLINE</span>
                                                    <span v-if="record.isWebSocket" class="badge bg-info text-dark font-monospace px-1.5 py-0.5" style="font-size: 0.65rem;">WS</span>
                                                    <span v-if="record.enableTimeLimit" class="badge bg-warning text-dark font-monospace px-1.5 py-0.5" style="font-size: 0.65rem;">TIMED</span>
                                                </div>
                                                <span class="badge bg-light text-secondary border font-monospace fw-bold" style="font-size: 0.65rem;">
                                                    {{ record.routeGroup }}
                                                </span>
                                            </div>

                                            <div class="card-body p-3 d-flex flex-column gap-2.5">
                                                <div>
                                                    <b class="text-primary font-monospace d-block" style="font-size: 0.95rem;">{{ record.code }}</b>
                                                    <span class="text-dark fw-bold d-block lh-sm my-0.5" style="font-size: 0.85rem;">{{ record.name }}</span>
                                                    <span v-if="record.description" class="text-muted d-block text-truncate fs-12">{{ record.description }}</span>
                                                </div>

                                                <div class="bg-light p-2.5 rounded border border-light-subtle d-flex flex-column gap-2">
                                                    <div class="d-flex align-items-baseline gap-2">
                                                        <span class="badge font-monospace text-uppercase text-center shadow-xs" v-bind:class="getBadgeClass(record.upstreamHttpMethod)" style="width: 50px; font-size: 0.6rem; padding: 2px 0;">
                                                            {{ record.upstreamHttpMethod || 'ANY' }}
                                                        </span>
                                                        <span class="font-monospace text-danger fw-bold text-break fs-12">{{ record.upstreamPathTemplate }}</span>
                                                    </div>

                                                    <div v-if="record.authenticationProviderKey || record.upstreamHost" class="ps-2 d-flex flex-column gap-0.5 text-muted font-monospace" style="font-size: 0.7rem;">
                                                        <div v-if="record.authenticationProviderKey"><i class="fas fa-key me-1 text-primary"></i>Auth: {{ record.authenticationProviderKey }}</div>
                                                        <div v-if="record.upstreamHost"><i class="fas fa-globe me-1 text-primary"></i>Host: {{ record.upstreamHost }}</div>
                                                    </div>

                                                    <div class="d-flex align-items-baseline gap-2 border-top pt-2">
                                                        <span class="badge bg-dark text-light font-monospace shadow-xs text-center text-uppercase" style="width: 50px; font-size: 0.6rem; padding: 2px 0;">
                                                            {{ record.downstreamScheme }}
                                                        </span>
                                                        <span class="font-monospace text-success fw-bold text-break fs-12">{{ record.downstreamPathTemplate }}</span>
                                                    </div>
                                                </div>

                                                <div class="d-flex flex-wrap gap-1.5 align-items-center bg-body p-2 border rounded">
                                                    <span class="font-monospace text-dark ps-0.5" style="font-size: 0.75rem;">
                                                        <i class="fas fa-server text-black-50 me-1"></i>Nodes: <b>{{ record.useServiceDiscovery ? 'Registry' : (record.hosts ? record.hosts.length : 0) }}</b>
                                                    </span>
                                                    <span class="text-black-50" style="font-size: 0.75rem;">|</span>
                                                    <span class="font-monospace text-dark" style="font-size: 0.75rem;">
                                                        <i class="fas fa-user-shield text-black-50_50 me-1"></i>Clients: <b>{{ record.clients ? record.clients.length : 0 }}</b>
                                                    </span>
                                                    <span class="text-black-50" style="font-size: 0.75rem;">|</span>
                                                    <span class="font-monospace text-dark" style="font-size: 0.75rem;">
                                                        <i class="fas fa-sliders-h text-black-50 me-1"></i>LB: <b>{{ record.loadBalancerType }}</b>
                                                    </span>
                                                </div>

                                                <div v-if="record.dangerousAcceptAnyServerCertificateValidator" class="bg-warning-subtle text-warning-emphasis p-2 border border-warning rounded font-monospace" style="font-size: 0.7rem;">
                                                    <i class="fas fa-exclamation-triangle me-1"></i>SSL verification logic bypassed on this lane.
                                                </div>

                                                <div class="d-flex flex-wrap gap-1.5 pt-1">
                                                    <span v-if="record.enableRateLimiting" class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-2 py-1 fs-11">
                                                        <i class="fas fa-filter me-1"></i> Rate: {{ record.rateLimit }}/{{ record.ratePeriod }}
                                                    </span>
                                                    <span v-if="record.enableCaching" class="badge bg-success-subtle text-success border border-success-subtle font-monospace px-2 py-1 fs-11">
                                                        <i class="fas fa-database me-1"></i> Cache: {{ record.cacheTtlSeconds }}s
                                                    </span>
                                                    <span v-if="record.enableQoS" class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle font-monospace px-2 py-1 fs-11">
                                                        <i class="fas fa-heartbeat me-1"></i> QoS: {{ record.qoSTimeoutMs }}ms
                                                    </span>
                                                    <span v-if="record.requireSignature" class="badge bg-danger-subtle text-danger border border-danger-subtle font-monospace px-2 py-1 fs-11">
                                                        <i class="fas fa-signature me-1"></i> HMAC
                                                    </span>
                                                    <span v-if="!record.enableRateLimiting && !record.enableCaching && !record.enableQoS && !record.requireSignature" class="text-muted font-monospace ps-0.5 fs-11 italic">
                                                        No active policy parameters.
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="card-footer bg-light p-2 d-flex justify-content-end gap-2">
                                                @if (Model.Permission.Contains("[VIEW]"))
                                                {
                                                    <button type="button" class="btn btn-outline-success btn-sm px-3 flex-grow-1" v-on:click="View(record)">
                                                        <i class="fas fa-eye me-1"></i>View
                                                    </button>
                                                }
                                                @if (Model.Permission.Contains("[EDIT]"))
                                                {
                                                    <button type="button" class="btn btn-outline-info btn-sm px-3 flex-grow-1" v-on:click="Edit(record)">
                                                        <i class="fas fa-edit me-1"></i>Edit
                                                    </button>
                                                }
                                                @if (Model.Permission.Contains("[DELETE]"))
                                                {
                                                    <button type="button" class="btn btn-outline-danger btn-sm px-3 flex-grow-1" v-on:click="Delete(record);" v-if="record.isActive">
                                                        <i class="far fa-trash-alt me-1"></i>Disable
                                                    </button>
                                                }
                                                @if (Model.Permission.Contains("[RESTORE]"))
                                                {
                                                    <button type="button" class="btn btn-outline-warning btn-sm px-3 flex-grow-1" v-on:click="Restore(record);" v-if="!record.isActive">
                                                        <i class="fas fa-undo me-1"></i>Enable
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 mt-3" v-show="show_table">
                                    <ul id="sync-pagination" class="pagination pagination-sm float-end"></ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="routeModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="routeModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header bg-dark text-white">
                            <h5 class="modal-title" id="routeModalLabel">
                                <i class="fas" :class="isEditMode ? 'fa-edit text-info' : 'fa-plus-circle text-success'"></i>
                                {{ isEditMode ? 'Edit Route Settings' : 'Create New Gateway Route' }}
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" v-on:click="resetForm"></button>
                        </div>

                        <div class="modal-body p-0">
                            <div class="d-flex flex-column flex-md-row w-100" style="min-height: 550px;">
                                <div class="bg-light border-end p-3" style="width: 260px; min-width: 260px;">
                                    <div class="nav flex-column nav-pills">

                                        <button type="button" class="nav-link d-flex align-items-center text-start py-2.5 mb-1 text-nowrap shadow-sm border border-light-subtle" :style="modalTab === 'general' ? 'background-color: #0d6efd !important; color: #ffffff !important;' : 'background-color: #ffffff !important; color: #333333 !important;'" v-on:click="modalTab = 'general'">
                                            <i class="fas fa-network-wired me-2"></i> 1. Basic Settings
                                            <i v-if="tabErrors.general" class="fas fa-exclamation-circle text-danger ms-auto ps-2" title="Contains invalid parameters"></i>
                                        </button>

                                        <button type="button" class="nav-link d-flex align-items-center text-start py-2.5 mb-1 text-nowrap shadow-sm border border-light-subtle" :style="modalTab === 'hosts' ? 'background-color: #0d6efd !important; color: #ffffff !important;' : 'background-color: #ffffff !important; color: #333333 !important;'" v-on:click="modalTab = 'hosts'">
