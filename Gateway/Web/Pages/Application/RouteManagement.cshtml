                                                    <div class="col-md-4">
                                                        <label class="form-label small fw-semibold">Cache Object Expiry Ttl Duration (Seconds)</label>
                                                        <input type="number" class="form-control" name="qos_cache_ttl" v-model.number="formData.cacheTtlSeconds" placeholder="300" data-parsley-trigger="change focusout" data-parsley-required="true" data-parsley-restrict-numeric-only="true" />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="card p-4 bg-light-subtle border border-light-subtle shadow-sm">
                                                <div class="form-check form-switch mb-3">
                                                    <input class="form-check-input" type="checkbox" id="modalQos" name="qos_breaker_enabled" v-model="formData.enableQoS">
                                                    <label class="form-check-label fw-bold text-dark" for="modalQos">Enable Dynamic Circuit Breaker Isolation (QoS Resiliency System)</label>
                                                </div>
                                                <div class="row g-3" v-if="formData.enableQoS">
                                                    <div class="col-md-4">
                                                        <label class="form-label small fw-semibold">Gateway Processing Execution Timeout (ms)</label>
                                                        <input type="number" class="form-control" name="qos_breaker_timeout" v-model.number="formData.qoSTimeoutMs" data-parsley-trigger="change focusout" data-parsley-required="true" data-parsley-restrict-numeric-only="true" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label small fw-semibold">Consecutive Errors Threshold Count Before Tripping</label>
                                                        <input type="number" class="form-control" name="qos_breaker_failures" v-model.number="formData.qoSExceptionsAllowedBeforeBreaking" data-parsley-trigger="change focusout" data-parsley-required="true" data-parsley-restrict-numeric-only="true" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label small fw-semibold">Breaker Open Circuit Recovery Hold Sleep Time (ms)</label>
                                                        <input type="number" class="form-control" name="qos_breaker_duration" v-model.number="formData.qoSDurationOfBreakMs" data-parsley-trigger="change focusout" data-parsley-required="true" data-parsley-restrict-numeric-only="true" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div v-show="modalTab === 'advanced'" data-tab-name="advanced">
                                            <h4 class="mb-3 border-bottom pb-2 text-primary">Discovery Registry & Execution Schedules</h4>

                                            <div class="card p-3 mb-3 bg-light-subtle shadow-sm border border-light-subtle">
                                                <div class="form-check form-switch mb-3">
                                                    <input class="form-check-input" type="checkbox" id="modalDiscovery" name="discovery_enabled" v-model="formData.useServiceDiscovery">
                                                    <label class="form-check-label fw-bold text-dark" for="modalDiscovery">Source Cluster Nodes via Cloud Microservice Registry Provider</label>
                                                </div>
                                                <div class="row g-3" v-if="formData.useServiceDiscovery">
                                                    <div class="col-md-6">
                                                        <label class="form-label small fw-bold">Service Discovery Registry Endpoint Key Name</label>
                                                        <input type="text" class="form-control" name="discovery_name" v-model="formData.serviceName" placeholder="e.g., payment-processing-microservice" data-parsley-trigger="change focusout" data-parsley-required="true" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label small fw-bold">Cluster Logical Namespace Target Scope</label>
                                                        <input type="text" class="form-control" name="discovery_namespace" v-model="formData.serviceNamespace" placeholder="e.g., core-banking-production" />
                                                    </div>
                                                    <div class="col-md-6 pt-3">
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" id="modalPolling" name="discovery_polling_enabled" v-model="formData.enableServicePolling">
                                                            <label class="form-check-label small fw-bold" for="modalPolling">Enforce Continuous Polling Thread Task Registry Refreshes</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6" v-if="formData.enableServicePolling">
                                                        <label class="form-label small fw-bold">Polling Registry Query Sync Clock Interval Speed (ms)</label>
                                                        <input type="number" class="form-control" name="discovery_polling_interval" v-model.number="formData.pollingIntervalMs" data-parsley-trigger="change focusout" data-parsley-required="true" data-parsley-restrict-numeric-only="true" />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="card p-3 bg-light-subtle shadow-sm border border-light-subtle">
                                                <div class="form-check form-switch mb-3">
                                                    <input class="form-check-input" type="checkbox" id="modalTimeLimit" name="schedule_enabled" v-model="formData.enableTimeLimit">
                                                    <label class="form-check-label fw-bold text-dark" for="modalTimeLimit">Enforce Route Operational Availability Window Constraints</label>
                                                </div>
                                                <div class="row g-3" v-if="formData.enableTimeLimit">
                                                    <div class="col-md-6">
                                                        <label class="form-label small fw-bold">Allow Traffic Entry Frame Time Hour (24h HH:mm format)</label>
                                                        <input type="text" class="form-control" name="schedule_time_from" v-model="formData.timeFrom" placeholder="06:00" data-parsley-trigger="change focusout" data-parsley-required="true" data-parsley-military-time="true" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label small fw-bold">Deactivate Target Forwarding Beyond Time Hour (24h HH:mm format)</label>
                                                        <input type="text" class="form-control" name="schedule_time_to" v-model="formData.timeTo" placeholder="22:00" data-parsley-trigger="change focusout" data-parsley-required="true" data-parsley-military-time="true" />
                                                    </div>
                                                    <div class="col-12">
                                                        <label class="form-label small d-block fw-bold mb-2">Allowed Days Operational Access Permission Grid Matrix</label>
                                                        <div class="d-flex flex-wrap gap-3 p-2 border rounded bg-white">
                                                            <div v-for="day in [{l:'Sunday',v:'0'},{l:'Monday',v:'1'},{l:'Tuesday',v:'2'},{l:'Wednesday',v:'3'},{l:'Thursday',v:'4'},{l:'Friday',v:'5'},{l:'Saturday',v:'6'}]" :key="day.v" class="form-check">
                                                                <input class="form-check-input" type="checkbox" :id="'day_' + day.v" :value="day.v" v-model="selectedDays" v-on:change="syncDaysToString">
                                                                <label class="form-check-label small" :for="'day_' + day.v">{{ day.l }}</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" v-on:click="resetForm">Cancel</button>
                            <button type="button" class="btn btn-success" :disabled="isSubmitting" v-on:click="triggerFormSubmit">
                                <span v-if="isSubmitting" class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <i class="fas fa-save me-1" v-else></i>
                                {{ isSubmitting ? 'Saving changes...' : (isEditMode ? 'Save Changes' : 'Publish Route') }}
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div id="filterModal" class="modal fade text-sm" tabindex="-1" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-md" role="document">
                    <form name="filterModal" id="filterForm" method="post" autocomplete="off" data-parsley-validate="">
                        <div class="modal-content">
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title left"> <i class="fas fa-search me-1"></i> Advanced Query Filtering</h5>
                                <button type="button" class="btn-close btn-close-white text-light" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row g-3">
                                    <div class="col-sm-12">
                                        <div class="form-group">
                                            <label class="form-label fw-bold">Route Target (Code or Name Pattern)</label>
                                            <input type="text" class="form-control" v-model="search.codeOrName" placeholder="Enter partial character strings..." />
                                        </div>
                                    </div>
                                    <div class="col-sm-12">
                                        <div class="form-group">
                                            <label class="form-label fw-bold">Upstream Inbound Path Lookup</label>
                                            <input type="text" class="form-control font-monospace" v-model="search.upstreamPath" placeholder="e.g., /api/v1/payments" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer justify-content-end">
                                <button type="button" class="btn btn-outline-secondary btn-sm me-2" v-on:click="FilterForm">Reset Filters</button>
                                <button type="button" class="btn btn-success btn-sm" v-on:click="Filter()"><i class="fas fa-check-circle me-1"></i> Execute Search</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </section>
</div>

@section scripts
{
    <script src="~/js/app/directive/common.js" asp-append-version="true"></script>
    <script src="~/js/app/services/route.js" asp-append-version="true"></script>
    <script src="~/js/app/services/branch.js" asp-append-version="true"></script>
    <script src="~/js/app/services/client.js" asp-append-version="true"></script>
    <script src="~/js/app/controller/application/routemanagement/index.js" asp-append-version="true"></script>
}